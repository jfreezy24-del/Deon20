// Unicorn Model
// Liquidity sweep -> breaker (and "unicorn": a breaker overlapped by an FVG)
// with R projections, break-even protection, session filters and HTF context.

//@version=5
indicator("Unicorn Model", shorttitle="Unicorn", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=500)

type UnicornSetup
    bool    isBull
    bool    isUnicorn
    string  sweepLabel
    float   zoneTop
    float   zoneBot
    int     sweepBar
    int     activationBar
    int     activationYear
    int     activationMonth
    float   invalidLevel
    float   entryPrice
    float   riskSize
    float   mainTarget
    int     state
    bool    alertedTarget
    bool    alertedInvalWarn
    bool    alertedInvalHit
    bool    alertedBE
    bool    isBEActive
    box     zoneBox
    box[]   fvgBoxes
    line    sweepLine
    label   sweepLbl
    line[]  targetLines
    label[] targetLabels
    line    bb50Line
    line[]  fvgCeLines
    line    beTriggerLine
    label   beTriggerLabel

type HtfFVG
    box     fvgBox
    line    midline
    label   fvgLabel
    float   top
    float   bottom
    bool    isBullish

type SMT
    string  smtType
    string  smtPair
    float   prevChartHigh
    float   currChartHigh
    int     prevChartHighTime
    int     currChartHighTime
    float   prevChartLow
    float   currChartLow
    int     prevChartLowTime
    int     currChartLowTime
    int     creationBar
    line    smtLine

type Candle
    float           o
    float           c
    float           h
    float           l
    int             o_idx
    int             c_idx
    int             h_idx
    int             l_idx
    box             body
    line            wick_up
    line            wick_down
    line            line_o
    line            line_h
    line            line_l
    line            line_c
    label           lbl_o
    label           lbl_h
    label           lbl_l
    label           lbl_c

type CandleSettings
    bool            show
    int             max_display

type SettingsCandle
    color           bull_body
    color           bull_border
    color           bull_wick
    color           bear_body
    color           bear_border
    color           bear_wick
    int             offset
    int             buffer
    int             width
    color           line_color

type CandleSet
    Candle[]        candles
    CandleSettings  settings
    label           infoLabel
    int             htf_start_bar
    float           htf_open_price
    float           htf_high_trace
    float           htf_low_trace

