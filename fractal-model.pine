//@version=6
// =============================================================================
// Fractal Model
// -----------------------------------------------------------------------------
// An implementation of the TTrades Fractal Model, built from the feature set
// and setting-by-setting breakdown published at
// https://ttrades.com/fractal-model-indicator/ and its full guide.
//
// THE MODEL, IN ONE PARAGRAPH
//
// The model reads a higher timeframe (HTF) as a rolling four-candle sequence.
// Candle 1 is the candle whose high or low holds the liquidity. Candle 2 runs
// that liquidity and closes back inside Candle 1's range — a *reversal
// closure*, the turning point. If Candle 2 fails to close back inside, Candle 3
// can still confirm by closing beyond Candle 2's *body* without having swept
// it. Either way, the candle that follows the closure is the expansion leg.
// Everything else the indicator draws — the CISD, the equilibrium, the T-Spot,
// the projections, the liquidity targets — exists to time and target that
// expansion.
//
// The timeframe pairings are fractal: every HTF candle is read on the aligned
// execution timeframe below it.
//
//     1M  <- 1D        4H  <- 15m
//     1W  <- 4H        1H  <-  5m
//     1D  <- 1H       30m  <-  3m
//                     15m  <-  1m
//
// WHAT GETS DRAWN
//
//   HTF Candles        The aligned HTF rendered as candles to the right of
//                      price, so the HTF sequence is readable without leaving
//                      the execution timeframe. Optional open line, period
//                      dividers, prior high/low, prior equilibrium.
//   C1 Sweep           The Candle 1 level that Candle 2 ran.
//   CISD               Change In State Of Delivery: the open of the first
//                      candle of the opposing run that price closed back
//                      through. This is the execution-timeframe confirmation
//                      of the HTF closure, and can be shown early — before the
//                      HTF candle has closed.
//   Candle EQ          The midpoint of the closure candle's range, wick to
//                      wick. Price is expected to respect the half in the
//                      direction of the model.
//   T-Spot             The zone between the HTF open and the prior candle's
//                      equilibrium — support in a bullish model, resistance in
//                      a bearish one.
//   Projections        Standard-deviation targets struck from the manipulation
//                      leg: in a bullish model, the low and the high that made
//                      it. Negative fib levels project beyond the leg.
//   Formation Liq.     Prior HTF highs and lows sitting in front of the model.
//                      These are the draw on liquidity, and the first targets.
//   SMT                Divergence against a correlated market at the sweep: one
//                      makes the new extreme, the other refuses to.
//
// BIAS
//
// Auto Bias runs the same closure logic one (Auto Bias 1) or two (Auto Bias 2)
// timeframes further up the ladder and suppresses any model that disagrees with
// it, so only the setups aligned with the higher timeframe are drawn.
//
// REPAINTING
//
// HTF candles are aggregated forward from chart bars rather than pulled with
// lookahead, so a closed HTF candle is a closed HTF candle and historical
// drawings sit where they sat live. The one intentionally live element is Early
// CISD, which by definition reports before the HTF candle closes and can
// therefore un-form; it draws in its own style and is off by default.
// =============================================================================

indicator("Fractal Model", shorttitle="TTFM", overlay=true, dynamic_requests=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=2000)

// =============================================================================
// INPUTS
// =============================================================================

// --- General ----------------------------------------------------------------
G_GEN = "General"
showWarnings  = input.bool(true, "Warnings and Error Messages", group=G_GEN, tooltip="Surfaces errors and warnings in the info table — most commonly that the chart timeframe is at or above the selected fractal, which leaves nothing to execute on.")
alertsOn      = input.bool(true, "Alerts", group=G_GEN, tooltip="Master switch for alert() calls. With this off no alert can fire, whatever the individual alert toggles say.")
historyCount  = input.int(2, "History", minval=0, maxval=20, group=G_GEN, tooltip="How many completed models to keep on the chart. 0 shows only the current one.")
fractalOpt    = input.string("Automatic", "Fractal", options=["Automatic", "15m", "30m", "1H", "4H", "1D", "1W", "1M", "Custom"], group=G_GEN, tooltip="The higher timeframe the model is read on. Automatic pairs off your chart timeframe.")
showC2        = input.bool(true, "C2", group=G_GEN, inline="c", tooltip="Candle 2 closures — the sweep of Candle 1 with a close back inside its range.")
showC3        = input.bool(true, "C3", group=G_GEN, inline="c", tooltip="Candle 3 closures — Candle 2 failed to close back inside, and Candle 3 closes beyond its body without sweeping it.")
showC4        = input.bool(true, "C4", group=G_GEN, inline="c", tooltip="Candle 4 continuations — the expansion candle that follows a closure.")
customFractal = input.timeframe("240", "Custom Fractal", group=G_GEN, tooltip="Only used when Fractal is set to Custom.")
biasOpt       = input.string("Neutral", "Bias", options=["Neutral", "Bullish", "Bearish", "Auto Bias 1", "Auto Bias 2"], group=G_GEN, tooltip="Neutral draws both directions. Bullish/Bearish draw one. Auto Bias 1 and 2 read the same model one or two timeframes above the fractal and draw only what agrees with it.")

