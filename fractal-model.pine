showHtfOpen  = input.bool(true,  "HTF Open", group=G_HTF, inline="op", tooltip="The opening price of the higher timeframe candle your chart sits inside.")
htfOpenColor = input.color(color.new(#787b86, 0), "", group=G_HTF, inline="op")
