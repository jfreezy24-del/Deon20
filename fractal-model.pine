showLHLines = input.bool(false, "L/H Lines", group=G_HTF, inline="lh", tooltip="The previous higher timeframe candle's high and low — resting liquidity. Off by default.")
lhColor     = input.color(color.new(#787b86, 25), "", group=G_HTF, inline="lh")
