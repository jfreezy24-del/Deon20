htfSizeOpt  = input.string("Normal", "Size", options=["Hidden", "Small", "Normal", "Large"], group=G_HTF)
htfOffset   = input.int(10, "Offset", minval=1, maxval=300, group=G_HTF, tooltip="Pushes the HTF candles further right. Running two copies of this indicator at once? Offset one of them by 17 or more so they don't stack.")
bullBody    = input.color(#26a69a, "Body",   group=G_HTF, inline="body")
