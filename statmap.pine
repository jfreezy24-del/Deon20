//
// ─────────────────────────────────────────────────────────────────────────────
// StatMap — Statistical Mapping & Volatility
//
// A statistical mapping toolkit inspired by the concepts described at
// stat-map.com. For each completed period of a chosen timeframe (or custom
// session) the script checks whether price closed up or down, then measures:
//   • Manipulation — the adverse excursion from the open (the "trap" move)
//   • Distribution — the favorable extension from the open (the real move)
// The mean and/or median of those measurements over the lookback window are
// projected from the current period's open, marking statistically likely
// reversal (manipulation) and target (distribution) zones.
//
// Also included:
//   • Up to 3 custom session mappings (e.g. London / New York / Asia)
//   • Time projections — the average time of day the period high/low forms
//   • Statistical Volatility — displacement candles flagged when their size
//     exceeds historical norms, drawn as zones with midpoint + fill tracking
//   • Alerts — level touches, displacement creation / first touch /
//     midpoint touch / fill
// ─────────────────────────────────────────────────────────────────────────────

//@version=6
indicator("StatMap — Statistical Mapping & Volatility", shorttitle="StatMap", overlay=true,
     dynamic_requests=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ════════════════════════════════ INPUTS ════════════════════════════════

const string G_MAP   = "Statistical Mapping"
const string G_TF    = "Timeframe Mapping"
const string G_SESS  = "Session Mapping"
const string G_TIME  = "Time Projections"
const string G_VOL   = "Statistical Volatility"
const string G_STYLE = "Style"
const string G_TABLE = "Stats Table"

lookback   = input.int(60, "Lookback Periods", minval=5, maxval=250, group=G_MAP, tooltip="Number of completed historical periods sampled to build the statistics.")
calcMethod = input.string("Both", "Calculation Method", options=["Mean", "Median", "Both"], group=G_MAP, tooltip="Mean: arithmetic average — sensitive to outliers, projects further.\nMedian: middle value — resistant to outliers, higher-probability targets.\nBoth: plots both and fills the band between them.")
scenario   = input.string("Both", "Scenario", options=["Both", "Bullish", "Bearish"], group=G_MAP, tooltip="Bullish: projections measured from periods that closed up.\nBearish: projections measured from periods that closed down.")
showDist   = input.bool(true, "Distribution Levels", group=G_MAP, inline="d")
distColor  = input.color(#26a69a, "", group=G_MAP, inline="d", tooltip="Favorable extension from the open — used as targets.")
showManip  = input.bool(true, "Manipulation Levels", group=G_MAP, inline="m")
manipColor = input.color(#ef5350, "", group=G_MAP, inline="m", tooltip="Adverse excursion from the open — trap zones that often precede reversals.")
showBand   = input.bool(true, "Fill Mean ↔ Median Band", group=G_MAP, tooltip="Only applies when Calculation Method is set to Both.")
keepHist   = input.int(2, "Historical Periods to Keep", minval=0, maxval=20, group=G_MAP)

enableTF = input.bool(true, "Enable Timeframe Mapping", group=G_TF)
autoTF   = input.bool(true, "Auto Timeframe", group=G_TF, inline="tf", tooltip="Auto picks a higher timeframe based on the chart timeframe. Turn off to map a fixed timeframe.")
mapTF    = input.timeframe("D", "", group=G_TF, inline="tf")

showTimeProj  = input.bool(true, "Project Avg High/Low Times", group=G_TIME, tooltip="Vertical markers at the average time of period the high and low have historically formed (timeframe mapping only).")
timeProjColor = input.color(color.new(color.gray, 30), "", group=G_TIME)

sessTZ = input.string("America/New_York", "Session Timezone", group=G_SESS)
s1On   = input.bool(false, "S1", inline="s1", group=G_SESS)
s1Name = input.string("LDN", "", inline="s1", group=G_SESS)
s1Str  = input.session("0200-0500", "", inline="s1", group=G_SESS)
s2On   = input.bool(false, "S2", inline="s2", group=G_SESS)
s2Name = input.string("NY", "", inline="s2", group=G_SESS)
s2Str  = input.session("0930-1200", "", inline="s2", group=G_SESS)
s3On   = input.bool(false, "S3", inline="s3", group=G_SESS)
s3Name = input.string("ASIA", "", inline="s3", group=G_SESS)
s3Str  = input.session("1900-2300", "", inline="s3", group=G_SESS)

volOn         = input.bool(true, "Enable Displacement Detection", group=G_VOL)
volMeasure    = input.string("Range", "Measure", options=["Range", "Body"], group=G_VOL, tooltip="What is compared against the historical baseline, and what the zone covers.")
volLen        = input.int(100, "Baseline Length", minval=10, maxval=500, group=G_VOL)
volMethod     = input.string("Z-Score", "Threshold Method", options=["Z-Score", "Multiplier"], group=G_VOL, tooltip="Z-Score: candle exceeds baseline + N standard deviations.\nMultiplier: candle exceeds N × the baseline average.")
volZ          = input.float(3.0, "Z-Score Threshold", minval=0.5, step=0.1, group=G_VOL)
volMult       = input.float(2.5, "Multiplier Threshold", minval=1.0, step=0.1, group=G_VOL)
showMid       = input.bool(true, "Show Midpoint Line", group=G_VOL)
markDisp      = input.bool(true, "Mark Displacement Candles", group=G_VOL)
maxDisp       = input.int(15, "Max Displacement Zones", minval=1, maxval=50, group=G_VOL)
bullDispColor = input.color(color.new(#26a69a, 80), "Bullish", inline="dc", group=G_VOL)
bearDispColor = input.color(color.new(#ef5350, 80), "Bearish", inline="dc", group=G_VOL)

meanStyle  = input.string("Solid", "Mean Line", options=["Solid", "Dashed", "Dotted"], group=G_STYLE)
medStyle   = input.string("Dashed", "Median Line", options=["Solid", "Dashed", "Dotted"], group=G_STYLE)
lineWidth  = input.int(1, "Line Width", minval=1, maxval=5, group=G_STYLE)
showLabels = input.bool(true, "Show Level Labels", group=G_STYLE, inline="ls")
labelSize  = input.string("small", "", options=["tiny", "small", "normal"], group=G_STYLE, inline="ls")

showTable = input.bool(true, "Show Stats Table", group=G_TABLE)
tablePos  = input.string("Top Right", "Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=G_TABLE)

// ════════════════════════════════ HELPERS ════════════════════════════════

f_style(string s) =>
    s == "Dotted" ? line.style_dotted : s == "Dashed" ? line.style_dashed : line.style_solid

f_pos(string p) =>
    p == "Top Left" ? position.top_left : p == "Bottom Left" ? position.bottom_left : p == "Bottom Right" ? position.bottom_right : position.top_right

f_push(array<float> a, float v, int maxN) =>
    a.push(v)
    if a.size() > maxN
        a.shift()

f_capLines(array<line> a, int maxN) =>
    while a.size() > maxN
        line.delete(a.shift())

f_capLabels(array<label> a, int maxN) =>
    while a.size() > maxN
        label.delete(a.shift())

f_capFills(array<linefill> a, int maxN) =>
    while a.size() > maxN
        linefill.delete(a.shift())

f_autoTF() =>
    s = timeframe.in_seconds(timeframe.period)
    s <= 120 ? "60" : s <= 600 ? "240" : s <= 3600 ? "D" : s <= 14400 ? "W" : "M"

// Manipulation/Distribution statistics over the last `n` completed periods.
// Runs inside request.security() so offsets refer to higher-timeframe bars.
f_stats(int n) =>
    bullManip = array.new<float>()
    bullDist  = array.new<float>()
    bearManip = array.new<float>()
    bearDist  = array.new<float>()
    for i = 1 to n
        if not na(close[i]) and not na(open[i])
            up = close[i] >= open[i]
            m = up ? open[i] - low[i] : high[i] - open[i]
            d = up ? high[i] - open[i] : open[i] - low[i]
            if up
                bullManip.push(m)
                bullDist.push(d)
            else
                bearManip.push(m)
                bearDist.push(d)
    [bullManip.avg(), bullManip.median(), bullDist.avg(), bullDist.median(),
     bearManip.avg(), bearManip.median(), bearDist.avg(), bearDist.median(),
     bullManip.size(), bearManip.size()]

// Creates one projected level: line + label + touch-tracking registration.
f_addLevel(bool show, int t1, int t2, float price, color col, string styl, string txt, bool isManip,
     array<line> lns, array<label> lbls, array<float> lvlP, array<int> lvlTyp, array<bool> lvlHit) =>
    line ln = na
    if show and not na(price)
        ln := line.new(t1, price, t2, price, xloc=xloc.bar_time, color=col, style=f_style(styl), width=lineWidth)
        lns.push(ln)
        if showLabels
            lbls.push(label.new(t2, price, txt, xloc=xloc.bar_time, style=label.style_label_left, color=color(na), textcolor=col, size=labelSize))
        lvlP.push(price)
        lvlTyp.push(isManip ? 0 : 1)
        lvlHit.push(false)
    ln

f_pairFill(line a, line b, color col, array<linefill> fills) =>
    if showBand and not na(a) and not na(b)
        fills.push(linefill.new(a, b, color.new(col, 92)))

// Marks untouched levels hit by the current bar; fires once per level per period.
f_touch(array<float> lvlP, array<int> lvlTyp, array<bool> lvlHit) =>
    mT = false
    dT = false
    if lvlP.size() > 0
        for i = 0 to lvlP.size() - 1
            if not lvlHit.get(i)
                lv = lvlP.get(i)
                if not na(lv) and high >= lv and low <= lv
                    lvlHit.set(i, true)
                    if lvlTyp.get(i) == 0
                        mT := true
                    else
                        dT := true
    [mT, dT]

useMean    = calcMethod != "Median"
useMed     = calcMethod != "Mean"
showBullLv = scenario != "Bearish"
showBearLv = scenario != "Bullish"

// ════════════════════════ TIMEFRAME MAPPING ════════════════════════

tfUsed = enableTF ? (autoTF ? f_autoTF() : mapTF) : timeframe.period

[bManMean, bManMed, bDistMean, bDistMed, sManMean, sManMed, sDistMean, sDistMed, nBull, nBear] =
     request.security(syminfo.tickerid, tfUsed, f_stats(lookback), lookahead=barmerge.lookahead_off)
htfOpen = request.security(syminfo.tickerid, tfUsed, open, lookahead=barmerge.lookahead_off)

htfStart   = time(tfUsed)
htfEnd     = time_close(tfUsed)
htfChanged = ta.change(htfStart) != 0
newHTF     = enableTF and htfChanged and not na(htfOpen)

var htfLines  = array.new<line>()
var htfLabels = array.new<label>()
var htfFills  = array.new<linefill>()
var htfLvlP   = array.new<float>()
var htfLvlTyp = array.new<int>()
var htfLvlHit = array.new<bool>()

if newHTF
    htfLvlP.clear()
    htfLvlTyp.clear()
    htfLvlHit.clear()
    bdMn = f_addLevel(showBullLv and showDist and useMean,  htfStart, htfEnd, htfOpen + bDistMean, distColor,  meanStyle, "Bull Dist μ",  false, htfLines, htfLabels, htfLvlP, htfLvlTyp, htfLvlHit)
    bdMd = f_addLevel(showBullLv and showDist and useMed,   htfStart, htfEnd, htfOpen + bDistMed,  distColor,  medStyle,  "Bull Dist ~",  false, htfLines, htfLabels, htfLvlP, htfLvlTyp, htfLvlHit)
    bmMn = f_addLevel(showBullLv and showManip and useMean, htfStart, htfEnd, htfOpen - bManMean,  manipColor, meanStyle, "Bull Manip μ", true,  htfLines, htfLabels, htfLvlP, htfLvlTyp, htfLvlHit)
    bmMd = f_addLevel(showBullLv and showManip and useMed,  htfStart, htfEnd, htfOpen - bManMed,   manipColor, medStyle,  "Bull Manip ~", true,  htfLines, htfLabels, htfLvlP, htfLvlTyp, htfLvlHit)
    sdMn = f_addLevel(showBearLv and showDist and useMean,  htfStart, htfEnd, htfOpen - sDistMean, distColor,  meanStyle, "Bear Dist μ",  false, htfLines, htfLabels, htfLvlP, htfLvlTyp, htfLvlHit)
    sdMd = f_addLevel(showBearLv and showDist and useMed,   htfStart, htfEnd, htfOpen - sDistMed,  distColor,  medStyle,  "Bear Dist ~",  false, htfLines, htfLabels, htfLvlP, htfLvlTyp, htfLvlHit)
    smMn = f_addLevel(showBearLv and showManip and useMean, htfStart, htfEnd, htfOpen + sManMean,  manipColor, meanStyle, "Bear Manip μ", true,  htfLines, htfLabels, htfLvlP, htfLvlTyp, htfLvlHit)
    smMd = f_addLevel(showBearLv and showManip and useMed,  htfStart, htfEnd, htfOpen + sManMed,   manipColor, medStyle,  "Bear Manip ~", true,  htfLines, htfLabels, htfLvlP, htfLvlTyp, htfLvlHit)
    f_pairFill(bdMn, bdMd, distColor, htfFills)
    f_pairFill(bmMn, bmMd, manipColor, htfFills)
    f_pairFill(sdMn, sdMd, distColor, htfFills)
    f_pairFill(smMn, smMd, manipColor, htfFills)
    f_capLines(htfLines, (keepHist + 1) * 8)
    f_capLabels(htfLabels, (keepHist + 1) * 8)
    f_capFills(htfFills, (keepHist + 1) * 4)

[htfManipT, htfDistT] = f_touch(htfLvlP, htfLvlTyp, htfLvlHit)

// ════════════════════════ TIME PROJECTIONS ════════════════════════
// Tracks where inside each period the high/low formed (as a fraction of the
// period), then projects the average onto the current period.

var float perHi   = na
var float perLo   = na
var int   perHiT  = na
var int   perLoT  = na
var int   perStart = na
var hiFrac = array.new<float>()
var loFrac = array.new<float>()
var line  hiLn = na
var line  loLn = na
var label hiLb = na
var label loLb = na

if enableTF
    if newHTF
        if not na(perStart) and not na(perHiT)
            dur = time_close[1] - perStart
            if dur > 0
                f_push(hiFrac, (perHiT - perStart) / float(dur), lookback)
                f_push(loFrac, (perLoT - perStart) / float(dur), lookback)
        perStart := htfStart
        perHi  := high
        perLo  := low
        perHiT := time
        perLoT := time
        line.delete(hiLn)
        line.delete(loLn)
        label.delete(hiLb)
        label.delete(loLb)
        if showTimeProj and hiFrac.size() > 0 and not na(htfEnd)
            projHiT = int(math.round(htfStart + hiFrac.avg() * (htfEnd - htfStart)))
            projLoT = int(math.round(htfStart + loFrac.avg() * (htfEnd - htfStart)))
            hiLn := line.new(projHiT, htfOpen, projHiT, htfOpen + syminfo.mintick, xloc=xloc.bar_time, extend=extend.both, color=timeProjColor, style=line.style_dotted)
            loLn := line.new(projLoT, htfOpen, projLoT, htfOpen + syminfo.mintick, xloc=xloc.bar_time, extend=extend.both, color=timeProjColor, style=line.style_dotted)
            hiLb := label.new(projHiT, htfOpen, "Avg High Time", xloc=xloc.bar_time, style=label.style_label_up, color=color(na), textcolor=timeProjColor, size=size.tiny)
            loLb := label.new(projLoT, htfOpen, "Avg Low Time", xloc=xloc.bar_time, style=label.style_label_down, color=color(na), textcolor=timeProjColor, size=size.tiny)
    else if not na(perStart)
        if high > perHi
            perHi  := high
            perHiT := time
        if low < perLo
            perLo  := low
            perLoT := time

// ════════════════════════ SESSION MAPPING ════════════════════════

f_sessionMap(bool inSess, string name) =>
    starts = inSess and not inSess[1]
    ends   = not inSess and inSess[1]
    var bullManip = array.new<float>()
    var bullDist  = array.new<float>()
    var bearManip = array.new<float>()
    var bearDist  = array.new<float>()
    var float sOpen = na
    var float sHi   = na
    var float sLo   = na
    var actLines  = array.new<line>()
    var actLabels = array.new<label>()
    var allLines  = array.new<line>()
    var allLabels = array.new<label>()
    var allFills  = array.new<linefill>()
    var lvlP   = array.new<float>()
    var lvlTyp = array.new<int>()
    var lvlHit = array.new<bool>()
    if ends and not na(sOpen)
        up = close[1] >= sOpen
        f_push(up ? bullManip : bearManip, up ? sOpen - sLo : sHi - sOpen, lookback)
        f_push(up ? bullDist : bearDist, up ? sHi - sOpen : sOpen - sLo, lookback)
        actLines.clear()
        actLabels.clear()
        lvlP.clear()
        lvlTyp.clear()
        lvlHit.clear()
    if starts
        sOpen := open
        sHi   := high
        sLo   := low
        actLines.clear()
        actLabels.clear()
        lvlP.clear()
        lvlTyp.clear()
        lvlHit.clear()
        bdMn = f_addLevel(showBullLv and showDist and useMean,  time, time, sOpen + bullDist.avg(),     distColor,  meanStyle, name + " Bull Dist μ",  false, actLines, actLabels, lvlP, lvlTyp, lvlHit)
        bdMd = f_addLevel(showBullLv and showDist and useMed,   time, time, sOpen + bullDist.median(),  distColor,  medStyle,  name + " Bull Dist ~",  false, actLines, actLabels, lvlP, lvlTyp, lvlHit)
        bmMn = f_addLevel(showBullLv and showManip and useMean, time, time, sOpen - bullManip.avg(),    manipColor, meanStyle, name + " Bull Manip μ", true,  actLines, actLabels, lvlP, lvlTyp, lvlHit)
        bmMd = f_addLevel(showBullLv and showManip and useMed,  time, time, sOpen - bullManip.median(), manipColor, medStyle,  name + " Bull Manip ~", true,  actLines, actLabels, lvlP, lvlTyp, lvlHit)
        sdMn = f_addLevel(showBearLv and showDist and useMean,  time, time, sOpen - bearDist.avg(),     distColor,  meanStyle, name + " Bear Dist μ",  false, actLines, actLabels, lvlP, lvlTyp, lvlHit)
        sdMd = f_addLevel(showBearLv and showDist and useMed,   time, time, sOpen - bearDist.median(),  distColor,  medStyle,  name + " Bear Dist ~",  false, actLines, actLabels, lvlP, lvlTyp, lvlHit)
        smMn = f_addLevel(showBearLv and showManip and useMean, time, time, sOpen + bearManip.avg(),    manipColor, meanStyle, name + " Bear Manip μ", true,  actLines, actLabels, lvlP, lvlTyp, lvlHit)
        smMd = f_addLevel(showBearLv and showManip and useMed,  time, time, sOpen + bearManip.median(), manipColor, medStyle,  name + " Bear Manip ~", true,  actLines, actLabels, lvlP, lvlTyp, lvlHit)
        f_pairFill(bdMn, bdMd, distColor, allFills)
        f_pairFill(bmMn, bmMd, manipColor, allFills)
        f_pairFill(sdMn, sdMd, distColor, allFills)
        f_pairFill(smMn, smMd, manipColor, allFills)
        if actLines.size() > 0
            for i = 0 to actLines.size() - 1
                allLines.push(actLines.get(i))
        if actLabels.size() > 0
            for i = 0 to actLabels.size() - 1
                allLabels.push(actLabels.get(i))
        f_capLines(allLines, (keepHist + 1) * 8)
        f_capLabels(allLabels, (keepHist + 1) * 8)
        f_capFills(allFills, (keepHist + 1) * 4)
    if inSess
        sHi := math.max(sHi, high)
        sLo := math.min(sLo, low)
        if actLines.size() > 0
            for i = 0 to actLines.size() - 1
                line.set_x2(actLines.get(i), time)
        if actLabels.size() > 0
            for i = 0 to actLabels.size() - 1
                label.set_x(actLabels.get(i), time)
    f_touch(lvlP, lvlTyp, lvlHit)

inS1 = s1On and not na(time(timeframe.period, s1Str, sessTZ))
inS2 = s2On and not na(time(timeframe.period, s2Str, sessTZ))
inS3 = s3On and not na(time(timeframe.period, s3Str, sessTZ))

[s1ManipT, s1DistT] = f_sessionMap(inS1, s1Name)
[s2ManipT, s2DistT] = f_sessionMap(inS2, s2Name)
[s3ManipT, s3DistT] = f_sessionMap(inS3, s3Name)

// ════════════════════════ STATISTICAL VOLATILITY ════════════════════════

dMeasure   = volMeasure == "Body" ? math.abs(close - open) : high - low
dBase      = ta.sma(dMeasure, volLen)
dStdev     = ta.stdev(dMeasure, volLen)
dispThresh = volMethod == "Multiplier" ? dBase * volMult : dBase + dStdev * volZ
isDisp     = volOn and bar_index >= volLen and dMeasure > dispThresh and barstate.isconfirmed

var dBoxes  = array.new<box>()
var dMidLn  = array.new<line>()
var dTop    = array.new<float>()
var dBot    = array.new<float>()
var dBull   = array.new<bool>()
var dTouch  = array.new<bool>()
var dMidHit = array.new<bool>()
var dFill   = array.new<bool>()
var dBirth  = array.new<int>()

dispCreated    = false
dispTouched    = false
dispMidTouched = false
dispFilled     = false

if isDisp
    bull = close >= open
    zTop = volMeasure == "Body" ? math.max(open, close) : high
    zBot = volMeasure == "Body" ? math.min(open, close) : low
    col  = bull ? bullDispColor : bearDispColor
    dBoxes.push(box.new(bar_index, zTop, bar_index, zBot, border_color=color.new(col, 40), bgcolor=col))
    line ml = na
    if showMid
        ml := line.new(bar_index, (zTop + zBot) / 2, bar_index, (zTop + zBot) / 2, color=color.new(col, 30), style=line.style_dotted)
    dMidLn.push(ml)
    dTop.push(zTop)
    dBot.push(zBot)
    dBull.push(bull)
    dTouch.push(false)
    dMidHit.push(false)
    dFill.push(false)
    dBirth.push(bar_index)
    dispCreated := true
    while dBoxes.size() > maxDisp
        box.delete(dBoxes.shift())
        line.delete(dMidLn.shift())
        dTop.shift()
        dBot.shift()
        dBull.shift()
        dTouch.shift()
        dMidHit.shift()
        dFill.shift()
        dBirth.shift()

if dBoxes.size() > 0
    for i = 0 to dBoxes.size() - 1
        if not dFill.get(i)
            b = dBoxes.get(i)
            box.set_right(b, bar_index)
            ml = dMidLn.get(i)
            if not na(ml)
                line.set_x2(ml, bar_index)
            if bar_index > dBirth.get(i)
                zTop = dTop.get(i)
                zBot = dBot.get(i)
                mid  = (zTop + zBot) / 2
                bull = dBull.get(i)
                if not dTouch.get(i) and (bull ? low <= zTop : high >= zBot)
                    dTouch.set(i, true)
                    dispTouched := true
                if not dMidHit.get(i) and low <= mid and high >= mid
                    dMidHit.set(i, true)
                    dispMidTouched := true
                if bull ? low <= zBot : high >= zTop
                    dFill.set(i, true)
                    dispFilled := true
                    box.set_bgcolor(b, color.new(color.gray, 92))
                    box.set_border_color(b, color.new(color.gray, 70))

plotchar(markDisp and isDisp and close >= open, "Bullish Displacement", "▲", location.belowbar, color=color.new(#26a69a, 0), size=size.tiny)
plotchar(markDisp and isDisp and close < open, "Bearish Displacement", "▼", location.abovebar, color=color.new(#ef5350, 0), size=size.tiny)

// ════════════════════════════════ ALERTS ════════════════════════════════

manipTouched = htfManipT or s1ManipT or s2ManipT or s3ManipT
distTouched  = htfDistT or s1DistT or s2DistT or s3DistT

alertcondition(manipTouched, "StatMap: Manipulation level touched", "StatMap — price touched a manipulation level on {{ticker}} ({{interval}}).")
alertcondition(distTouched, "StatMap: Distribution level touched", "StatMap — price touched a distribution level on {{ticker}} ({{interval}}).")
alertcondition(manipTouched or distTouched, "StatMap: Any level touched", "StatMap — price touched a statistical level on {{ticker}} ({{interval}}).")
alertcondition(dispCreated, "StatVol: Displacement created", "StatVol — displacement candle detected on {{ticker}} ({{interval}}).")
alertcondition(dispTouched, "StatVol: Displacement first touch", "StatVol — price returned to a displacement zone on {{ticker}} ({{interval}}).")
alertcondition(dispMidTouched, "StatVol: Displacement midpoint touch", "StatVol — price reached a displacement midpoint on {{ticker}} ({{interval}}).")
alertcondition(dispFilled, "StatVol: Displacement filled", "StatVol — a displacement zone was fully filled on {{ticker}} ({{interval}}).")

// ════════════════════════════════ TABLE ════════════════════════════════

f_row(table tb, int r, string nm, float mn, float md, int n, color col) =>
    table.cell(tb, 0, r, nm, text_color=col, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tb, 1, r, na(mn) ? "—" : str.tostring(mn, format.mintick), text_color=col, text_size=size.tiny)
    table.cell(tb, 2, r, na(md) ? "—" : str.tostring(md, format.mintick), text_color=col, text_size=size.tiny)
    table.cell(tb, 3, r, n > 0 ? str.tostring(n) : "—", text_color=col, text_size=size.tiny)

if showTable and barstate.islast
    var table tb = table.new(f_pos(tablePos), 4, 6, bgcolor=color.new(color.black, 80), border_width=1, border_color=color.new(color.gray, 85))
    hdrCol = color.new(color.white, 20)
    table.cell(tb, 0, 0, "StatMap · " + tfUsed, text_color=hdrCol, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tb, 1, 0, "Mean", text_color=hdrCol, text_size=size.tiny)
    table.cell(tb, 2, 0, "Median", text_color=hdrCol, text_size=size.tiny)
    table.cell(tb, 3, 0, "n", text_color=hdrCol, text_size=size.tiny)
    f_row(tb, 1, "Bull Dist", bDistMean, bDistMed, nBull, distColor)
    f_row(tb, 2, "Bull Manip", bManMean, bManMed, 0, manipColor)
    f_row(tb, 3, "Bear Dist", sDistMean, sDistMed, nBear, distColor)
    f_row(tb, 4, "Bear Manip", sManMean, sManMed, 0, manipColor)
    f_row(tb, 5, "Disp Base / Thr", dBase, dispThresh, 0, color.new(color.orange, 20))
