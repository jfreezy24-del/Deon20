//@version=6
indicator("OHLC StatMap (Multi-Timeframe)", shorttitle = 'OHLC', overlay = true, max_bars_back = 5000, max_lines_count = 100, max_labels_count = 100)

// === Timeframe Conversion ===
get_timeframe(tf_string) =>
    switch tf_string
        "1H" => "60"
        "4H" => "240"
        "1D" => "D"
        "1W" => "W"
        "1M" => "M"
        => ""

// === Input Definitions ===
// Timeframe Selection
tf1_input = input.string("4H", "Timeframe 1", options=["None", "1H", "4H", "1D", "1W", "1M"], tooltip="Select first timeframe", group = 'Timeframe settings')
tf1_converted = get_timeframe(tf1_input)
tf2_input = input.string("None", "Timeframe 2", options=["None", "1H", "4H", "1D", "1W", "1M"], tooltip="Select second timeframe", group = 'Timeframe settings')
tf2_converted = get_timeframe(tf2_input)
tf3_input = input.string("None", "Timeframe 3", options=["None", "1H", "4H", "1D", "1W", "1M"], tooltip="Select third timeframe", group = 'Timeframe settings')
tf3_converted = get_timeframe(tf3_input)
tf4_input = input.string("None", "Timeframe 4", options=["None", "1H", "4H", "1D", "1W", "1M"], tooltip="Select fourth timeframe", group = 'Timeframe settings')
tf4_converted = get_timeframe(tf4_input)
hist_candles = input.int(60, "Historical Candles", minval=1, maxval=100)

// Anchor Settings
show_anchor = input.bool(true, "Show Candle Anchor", inline="anchor", group = 'Anchor settings')
anchor_style = input.string("Dotted", "Anchor line style", options=["Solid", "Dashed", "Dotted"], inline="anchor")
anchor_color = input.color(color.black, "", inline="anchor")
anchor_width = input.int(1, "Line width", minval=1, maxval=4, inline="anchor")
show_anchor_label = input.bool(true, "Show Anchor Label")

// Quantile Settings
use_quantiles = input.bool(true, "Use Quantile Levels", group = 'Quantile Settings')
quantile_manip_low = input.float(25.0, "Manipulation Low Quantile (%)", minval=0, maxval=100, step=5, group = 'Quantile Settings')
quantile_manip_high = input.float(75.0, "Manipulation High Quantile (%)", minval=0, maxval=100, step=5, group = 'Quantile Settings')
quantile_dist_low = input.float(25.0, "Distribution Low Quantile (%)", minval=0, maxval=100, step=5, group = 'Quantile Settings')
quantile_dist_high = input.float(75.0, "Distribution High Quantile (%)", minval=0, maxval=100, step=5, group = 'Quantile Settings')
quantile_color_tf1 = input.color(color.gray, "Quantile Color TF1", group = 'Quantile Settings')
quantile_style = input.string("Dashed", "Quantile Line Style", options=["Solid", "Dashed", "Dotted"], group = 'Quantile Settings')
quantile_width = input.int(1, "Quantile Line Width", minval=1, maxval=4, group = 'Quantile Settings')
show_quantile_label = input.bool(true, "Show Quantile Labels", group = 'Quantile Settings')

// Open Line Settings
show_open = input.bool(true, "Show Open Line", inline="open", group = 'Open settings')
open_style = input.string("Dotted", "Open line style", options=["Solid", "Dashed", "Dotted"], inline="open")
open_color = input.color(color.gray, "Open line colour", inline="open")
open_width = input.int(1, "Line width", minval=1, maxval=4, inline="open")
show_open_label = input.bool(true, "Show Open Label")

// Manipulation Settings
show_manipulation = input.bool(true, "Show Manipulation Levels", inline="manipulation", group = 'Manipulation levels')
manipulation_style = input.string("Dotted", "Manipulation line style", options=["Solid", "Dashed", "Dotted"], inline="manipulation")
manipulation_color_tf1 = input.color(color.purple, "TF1 Color", inline="manipulation")
manipulation_color_tf2 = input.color(color.purple, "TF2 Color", inline="manipulation")
manipulation_color_tf3 = input.color(color.purple, "TF3 Color", inline="manipulation")
manipulation_color_tf4 = input.color(color.purple, "TF4 Color", inline="manipulation")
manipulation_width = input.int(1, "Line width", minval=1, maxval=4, inline="manipulation")
show_manipulation_label = input.bool(true, "Show Manipulation Labels")

// Distribution Settings
show_distribution = input.bool(true, "Show Distribution Levels", inline="distribution", group = 'Distribution levels')
distribution_style = input.string("Dotted", "Distribution line style", options=["Solid", "Dashed", "Dotted"], inline="distribution")
distribution_color_tf1 = input.color(color.blue, "TF1 Color", inline="distribution")
distribution_color_tf2 = input.color(color.blue, "TF2 Color", inline="distribution")
distribution_color_tf3 = input.color(color.blue, "TF3 Color", inline="distribution")
distribution_color_tf4 = input.color(color.blue, "TF4 Color", inline="distribution")
distribution_width = input.int(1, "Line width", minval=1, maxval=4, inline="distribution")
show_distribution_label = input.bool(true, "Show Distribution Labels")

// Median Settings
show_median = input.bool(true, "Show Median Levels", inline="median", group = 'Median levels')
median_style = input.string("Dotted", "Median level line style", options=["Solid", "Dashed", "Dotted"], inline="median")
median_color_tf1 = input.color(color.purple, "TF1 Color", inline="median")
median_color_tf2 = input.color(color.purple, "TF2 Color", inline="median")
median_color_tf3 = input.color(color.purple, "TF3 Color", inline="median")
median_color_tf4 = input.color(color.purple, "TF4 Color", inline="median")
median_width = input.int(1, "Line width", minval=1, maxval=4, inline="median")
show_median_label = input.bool(true, "Show Median Labels")

// Average High/Low Settings
show_avg_hl = input.bool(true, "Show Average High/Low Levels", inline="avg_hl", group = 'Average levels')
avg_hl_style = input.string("Dashed", "Average high/low line style", options=["Solid", "Dashed", "Dotted"], inline="avg_hl")
avg_hl_color_tf1 = input.color(color.green, "TF1 Color", inline="avg_hl")
avg_hl_color_tf2 = input.color(color.green, "TF2 Color", inline="avg_hl")
avg_hl_color_tf3 = input.color(color.green, "TF3 Color", inline="avg_hl")
avg_hl_color_tf4 = input.color(color.green, "TF4 Color", inline="avg_hl")
avg_hl_width = input.int(1, "Line width", minval=1, maxval=4, inline="avg_hl")
show_avg_hl_label = input.bool(true, "Show Avg High/Low Labels")

// Shading Settings
show_shading = input.bool(true, "Show Shaded Areas", inline="shading", group = 'Shading settings')
shading_manip_color_tf1 = input.color(color.new(color.purple, 90), "TF1 Manip Shading", inline="shading")
shading_manip_color_tf2 = input.color(color.new(color.purple, 90), "TF2 Manip Shading", inline="shading")
shading_manip_color_tf3 = input.color(color.new(color.purple, 90), "TF3 Manip Shading", inline="shading")
shading_manip_color_tf4 = input.color(color.new(color.purple, 90), "TF4 Manip Shading", inline="shading")
shading_dist_color_tf1 = input.color(color.new(color.blue, 90), "TF1 Dist Shading", inline="shading")
shading_dist_color_tf2 = input.color(color.new(color.blue, 90), "TF2 Dist Shading", inline="shading")
shading_dist_color_tf3 = input.color(color.new(color.blue, 90), "TF3 Dist Shading", inline="shading")
shading_dist_color_tf4 = input.color(color.new(color.blue, 90), "TF4 Dist Shading", inline="shading")

// Projection and Display Settings
projection_offset = input.int(24, "Projection Offset (Bars)", minval=0)
label_size = input.string("Small", "Label Size", options=["Tiny", "Small", "Normal", "Large"])

// === Helper Functions ===
get_line_style(style_string) =>
    style_string == "Solid" ? line.style_solid : style_string == "Dashed" ? line.style_dashed : line.style_dotted

get_label_size(size_string) =>
    size_string == "Tiny" ? size.tiny : size_string == "Small" ? size.small : size_string == "Normal" ? size.normal : size.large

get_quantile(arr, q) =>
    if array.size(arr) == 0
        na
    else
        sorted = array.copy(arr)
        array.sort(sorted)
        index = math.round((q / 100) * (array.size(sorted) - 1))
        array.get(sorted, index)

// === Types ===
// A symmetric pair of projected levels (upper/lower line plus their labels).
type LevelPair
    line  upper_ln
    line  lower_ln
    label upper_lb
    label lower_lb

type Shading
    box upper_manip
    box lower_manip
    box upper_dist
    box lower_dist

// All state for one tracked timeframe: the running OHLC of the current
// higher-timeframe candle, the rolling stat arrays of completed candles,
// and the drawing objects that get repositioned on each new candle.
type Tf
    string       name
    bool         was_new
    float        o
    float        h
    float        l
    float        c
    array<float> manips
    array<float> dists
    array<float> highs
    array<float> lows
    line         anchor_ln
    label        anchor_lb
    line         open_ln
    label        open_lb
    LevelPair    manip
    LevelPair    dist
    LevelPair    med_manip
    LevelPair    med_dist
    LevelPair    avg_hl
    LevelPair    quant_manip
    LevelPair    quant_dist
    Shading      shading

// === Constructors ===
new_level_pair(string upper_txt, string lower_txt, color col, string style, int width) =>
    ln_style = get_line_style(style)
    lb_size = get_label_size(label_size)
    bg = color.new(col, 100)
    LevelPair.new(
         line.new(bar_index, na, bar_index + 1, na, color = col, style = ln_style, width = width),
         line.new(bar_index, na, bar_index + 1, na, color = col, style = ln_style, width = width),
         label.new(bar_index, na, upper_txt, color = bg, textcolor = col, size = lb_size),
         label.new(bar_index, na, lower_txt, color = bg, textcolor = col, size = lb_size))

new_shading(color manip_col, color dist_col) =>
    Shading.new(
         box.new(bar_index, na, bar_index + 1, na, bgcolor = manip_col, border_width = 0),
         box.new(bar_index, na, bar_index + 1, na, bgcolor = manip_col, border_width = 0),
         box.new(bar_index, na, bar_index + 1, na, bgcolor = dist_col, border_width = 0),
         box.new(bar_index, na, bar_index + 1, na, bgcolor = dist_col, border_width = 0))

// Quantile levels are only drawn for TF1, matching the available inputs.
new_tf(string name, color manip_col, color dist_col, color med_col, color avg_col, color shade_manip_col, color shade_dist_col, bool with_quantiles) =>
    lb_size = get_label_size(label_size)
    Tf t = Tf.new()
    t.name := name
    t.was_new := false
    t.manips := array.new_float()
    t.dists := array.new_float()
    t.highs := array.new_float()
    t.lows := array.new_float()
    t.anchor_ln := line.new(bar_index, na, bar_index, na, xloc.bar_index, extend.both, anchor_color, get_line_style(anchor_style), anchor_width)
    t.anchor_lb := label.new(bar_index, na, "Start " + name, color = color.new(anchor_color, 100), textcolor = anchor_color, size = lb_size)
    t.open_ln := line.new(bar_index, na, bar_index + 1, na, color = open_color, style = get_line_style(open_style), width = open_width)
    t.open_lb := label.new(bar_index, na, "Open " + name, color = color.new(open_color, 100), textcolor = open_color, size = lb_size)
    t.manip := new_level_pair("-M " + name, "+M " + name, manip_col, manipulation_style, manipulation_width)
    t.dist := new_level_pair("+D " + name, "-D " + name, dist_col, distribution_style, distribution_width)
    t.med_manip := new_level_pair("-M (Med) " + name, "+M (Med) " + name, med_col, median_style, median_width)
    t.med_dist := new_level_pair("+D (Med) " + name, "-D (Med) " + name, med_col, median_style, median_width)
    t.avg_hl := new_level_pair("Avg High " + name, "Avg Low " + name, avg_col, avg_hl_style, avg_hl_width)
    if with_quantiles
        t.quant_manip := new_level_pair("-Q" + str.tostring(quantile_manip_high) + "M " + name, "+Q" + str.tostring(quantile_manip_low) + "M " + name, quantile_color_tf1, quantile_style, quantile_width)
        t.quant_dist := new_level_pair("+Q" + str.tostring(quantile_dist_high) + "D " + name, "-Q" + str.tostring(quantile_dist_low) + "D " + name, quantile_color_tf1, quantile_style, quantile_width)
    t.shading := new_shading(shade_manip_col, shade_dist_col)
    t

// === Drawing Methods ===
method set_levels(LevelPair p, int x1, int x2, float base, float up_dist, float dn_dist, bool show_labels) =>
    line.set_xy1(p.upper_ln, x1, base + up_dist)
    line.set_xy2(p.upper_ln, x2, base + up_dist)
    line.set_xy1(p.lower_ln, x1, base - dn_dist)
    line.set_xy2(p.lower_ln, x2, base - dn_dist)
    if show_labels
        label.set_xy(p.upper_lb, x2, base + up_dist)
        label.set_xy(p.lower_lb, x2, base - dn_dist)

method extend_to(LevelPair p, int x2, bool show_labels) =>
    line.set_x2(p.upper_ln, x2)
    line.set_x2(p.lower_ln, x2)
    if show_labels
        label.set_x(p.upper_lb, x2)
        label.set_x(p.lower_lb, x2)

// Shades the band between the average and median level on one side of the open.
set_band(box b, int x1, int x2, float level_a, float level_b) =>
    box.set_lefttop(b, x1, math.max(level_a, level_b))
    box.set_rightbottom(b, x2, math.min(level_a, level_b))

// === Per-Bar Logic ===
// Roll the running OHLC forward; when a candle completes, record its
// manipulation/distribution distances relative to its open. For an up-close
// the manipulation side is the low wick and distribution the high side, and
// vice versa for a down-close. Doji candles (close == open) are skipped.
method on_bar(Tf t, bool is_new) =>
    if is_new
        if not na(t.o)
            float manip = na
            float dist = na
            if t.c > t.o
                manip := t.o - t.l
                dist := t.h - t.o
            else if t.c < t.o
                manip := t.h - t.o
                dist := t.o - t.l
            if not na(manip)
                array.push(t.manips, manip)
                array.push(t.dists, dist)
                array.push(t.highs, t.h - t.o)
                array.push(t.lows, t.o - t.l)
                if array.size(t.manips) > hist_candles
                    array.shift(t.manips)
                    array.shift(t.dists)
                    array.shift(t.highs)
                    array.shift(t.lows)
        t.o := open
        t.h := high
        t.l := low
        t.c := close
    else
        t.h := math.max(t.h, high)
        t.l := math.min(t.l, low)
        t.c := close

// Reposition every drawing at the open of a new higher-timeframe candle.
method draw(Tf t) =>
    int x1 = bar_index
    int x2 = bar_index + projection_offset
    bool has_stats = array.size(t.manips) > 0
    float avg_manip = has_stats ? array.avg(t.manips) : na
    float avg_dist = has_stats ? array.avg(t.dists) : na
    float med_manip = has_stats ? array.median(t.manips) : na
    float med_dist = has_stats ? array.median(t.dists) : na
    float avg_high = array.size(t.highs) > 0 ? array.avg(t.highs) : na
    float avg_low = array.size(t.lows) > 0 ? array.avg(t.lows) : na
    if show_anchor
        line.set_xy1(t.anchor_ln, x1, t.o)
        line.set_xy2(t.anchor_ln, x1, t.o)
        if show_anchor_label
            label.set_xy(t.anchor_lb, x1, t.o + (not na(avg_dist) ? avg_dist : 0))
    if show_open
        line.set_xy1(t.open_ln, x1, t.o)
        line.set_xy2(t.open_ln, x2, t.o)
        if show_open_label
            label.set_xy(t.open_lb, x2, t.o)
    if show_manipulation and not na(avg_manip)
        t.manip.set_levels(x1, x2, t.o, avg_manip, avg_manip, show_manipulation_label)
    if show_distribution and not na(avg_dist)
        t.dist.set_levels(x1, x2, t.o, avg_dist, avg_dist, show_distribution_label)
    if show_median and not na(med_manip) and not na(med_dist)
        t.med_manip.set_levels(x1, x2, t.o, med_manip, med_manip, show_median_label)
        t.med_dist.set_levels(x1, x2, t.o, med_dist, med_dist, show_median_label)
    if show_avg_hl and not na(avg_high) and not na(avg_low)
        t.avg_hl.set_levels(x1, x2, t.o, avg_high, avg_low, show_avg_hl_label)
    if use_quantiles and not na(t.quant_manip)
        float qm_low = get_quantile(t.manips, quantile_manip_low)
        float qm_high = get_quantile(t.manips, quantile_manip_high)
        float qd_low = get_quantile(t.dists, quantile_dist_low)
        float qd_high = get_quantile(t.dists, quantile_dist_high)
        if not na(qm_low) and not na(qm_high) and not na(qd_low) and not na(qd_high)
            t.quant_manip.set_levels(x1, x2, t.o, qm_high, qm_low, show_quantile_label)
            t.quant_dist.set_levels(x1, x2, t.o, qd_high, qd_low, show_quantile_label)
    if show_shading and not na(avg_manip) and not na(med_manip) and not na(avg_dist) and not na(med_dist)
        set_band(t.shading.upper_manip, x1, x2, t.o + avg_manip, t.o + med_manip)
        set_band(t.shading.lower_manip, x1, x2, t.o - avg_manip, t.o - med_manip)
        set_band(t.shading.upper_dist, x1, x2, t.o + avg_dist, t.o + med_dist)
        set_band(t.shading.lower_dist, x1, x2, t.o - avg_dist, t.o - med_dist)

// Push the projected right edge one bar further on the bar after a new candle.
method extend_projection(Tf t) =>
    int x2 = bar_index + projection_offset
    if show_open
        line.set_x2(t.open_ln, x2)
        if show_open_label
            label.set_x(t.open_lb, x2)
    if show_manipulation
        t.manip.extend_to(x2, show_manipulation_label)
    if show_distribution
        t.dist.extend_to(x2, show_distribution_label)
    if show_median
        t.med_manip.extend_to(x2, show_median_label)
        t.med_dist.extend_to(x2, show_median_label)
    if show_avg_hl
        t.avg_hl.extend_to(x2, show_avg_hl_label)
    if use_quantiles and not na(t.quant_manip)
        t.quant_manip.extend_to(x2, show_quantile_label)
        t.quant_dist.extend_to(x2, show_quantile_label)
    if show_shading
        box.set_right(t.shading.upper_manip, x2)
        box.set_right(t.shading.lower_manip, x2)
        box.set_right(t.shading.upper_dist, x2)
        box.set_right(t.shading.lower_dist, x2)

process(Tf t, bool is_new) =>
    bool was_new = t.was_new
    t.was_new := is_new
    t.on_bar(is_new)
    if is_new
        t.draw()
    if was_new
        t.extend_projection()

// === Main ===
var Tf tf1 = new_tf(tf1_input, manipulation_color_tf1, distribution_color_tf1, median_color_tf1, avg_hl_color_tf1, shading_manip_color_tf1, shading_dist_color_tf1, true)
var Tf tf2 = new_tf(tf2_input, manipulation_color_tf2, distribution_color_tf2, median_color_tf2, avg_hl_color_tf2, shading_manip_color_tf2, shading_dist_color_tf2, false)
var Tf tf3 = new_tf(tf3_input, manipulation_color_tf3, distribution_color_tf3, median_color_tf3, avg_hl_color_tf3, shading_manip_color_tf3, shading_dist_color_tf3, false)
var Tf tf4 = new_tf(tf4_input, manipulation_color_tf4, distribution_color_tf4, median_color_tf4, avg_hl_color_tf4, shading_manip_color_tf4, shading_dist_color_tf4, false)

is_new_tf1 = tf1_converted != "" ? timeframe.change(tf1_converted) : false
is_new_tf2 = tf2_converted != "" ? timeframe.change(tf2_converted) : false
is_new_tf3 = tf3_converted != "" ? timeframe.change(tf3_converted) : false
is_new_tf4 = tf4_converted != "" ? timeframe.change(tf4_converted) : false

process(tf1, is_new_tf1)
process(tf2, is_new_tf2)
process(tf3, is_new_tf3)
process(tf4, is_new_tf4)
