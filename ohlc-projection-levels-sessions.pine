//@version=6
// =============================================================================
// OHLC Projection Levels — Sessions
// -----------------------------------------------------------------------------
// The session edition of ohlc-projection-levels.pine. Same statistical model —
// manipulation and distribution excursions measured from the period open and
// projected as levels with a stated probability — but the period is a TRADING
// SESSION rather than a fixed timeframe:
//
//     Asian     09:00-18:00  Asia/Tokyo
//     London    08:00-16:30  Europe/London
//     New York  09:30-16:00  America/New_York
//
// Each session is anchored in its OWN timezone, so daylight saving is handled
// by the exchange calendar rather than by hand. Times, timezone and days are
// editable per session.
//
// WHY THIS IS A SEPARATE SCRIPT, NOT A MODE
//   The timeframe edition runs its whole engine inside request.security at the
//   projection timeframe, which is what lets it walk thousands of periods of
//   higher-timeframe history. A session is not a timeframe, so it cannot be
//   requested that way. This script rebuilds every session bar by bar from the
//   CHART timeframe instead. The consequences are worth stating plainly:
//
//     - The sample is bounded by how much CHART history your plan loads, not by
//       the provider's higher-timeframe depth. Where the timeframe edition can
//       hold 2,000 daily periods, this one holds however many sessions fit in
//       your loaded bars. The table reports n; watch it.
//     - There is no pooled-feed or custom-history option. Those existed to
//       borrow depth across exchanges through request.security, which is not
//       available here.
//     - In exchange, intra-session information is directly visible, so the
//       timing and sequencing statistics are measured on the real sample rather
//       than a smaller side sample.
//     - Nothing repaints. A session's levels are frozen at its open out of
//       sessions that had already CLOSED, and never move again.
//
//   Run the chart timeframe well below the session length — 1m to 15m under a
//   9-hour session. The table warns when the chart timeframe is too coarse to
//   resolve the session at all.
//
// THE MODEL (identical to the timeframe edition)
//   * Manipulation (M) = the counter-trend excursion (liquidity / stop-hunt)
//   * Distribution (D) = the in-trend expansion       (profit targets)
//   In the default conditional mode, manipulation is sampled from sessions that
//   closed AGAINST that side and distribution from sessions that closed WITH
//   it. Four separate statistics are tracked (+M, -M, +D, -D) rather than one
//   number mirrored, because up and down excursions are not mirror images.
//
//   The sign names which side of the OPEN the level sits on: +M and +D are
//   above it, -M and -D below. This is the same convention as the timeframe
//   edition, and the inverse of OHLC Statistical Mapping Pro+, which signs by
//   the close direction of the sample instead.
//
// VOLATILITY NORMALIZATION
//   In "Log + ATR" mode each session is stored as its log excursion divided by
//   the average session range prevailing BEFORE it, then projected with the
//   current average. A quiet-market London and a CPI-day London stop being
//   averaged into a meaningless middle.
//
// HONEST SAMPLING
//   Standard errors sit next to every ratio, the table dims below the minimum
//   sample, reach and hold rates are measured strictly walk-forward (each
//   session judged only against the estimate frozen at ITS open), and the
//   both-side row reports how often BOTH manipulation levels were swept in one
//   session — the rate at which the model's own premise fails.
//
// As with any historical tool, past behaviour is not future performance.
// =============================================================================

indicator("OHLC Projection Levels — Sessions", shorttitle="OHLC Proj+ SESS",
     overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ================================== Inputs ===================================
grpS      = "Session"
sessSel   = input.string("New York", "Session", options=["Asian","London","New York"], group=grpS, tooltip="Which session to anchor the projection to. Each is defined in its own timezone below, so daylight saving follows the local calendar.")
sessDays  = input.string("23456", "Days", group=grpS, tooltip="1=Sunday .. 7=Saturday. 23456 is Mon-Fri. Set 1234567 to include weekends on instruments that trade them.")

grpSA     = "Session · Asian"
sessA     = input.session("0900-1800", "Hours", group=grpSA)
tzA       = input.string("Asia/Tokyo", "Timezone", group=grpSA)

grpSL     = "Session · London"
sessL     = input.session("0800-1630", "Hours", group=grpSL)
tzL       = input.string("Europe/London", "Timezone", group=grpSL)

grpSN     = "Session · New York"
sessN     = input.session("0930-1600", "Hours", group=grpSN)
tzN       = input.string("America/New_York", "Timezone", group=grpSN)

grpP        = "Projection"
periodsShow = input.int(2,  "Historical sessions to show", minval=1, maxval=20, group=grpP)
sampleLen   = input.int(250, "Sample size (completed sessions)", minval=10, maxval=2000, group=grpP, tooltip="Rolling window of completed sessions used for every statistic. Unlike the timeframe edition this cannot exceed what your chart history holds, so the effective sample is usually smaller than this cap. The table reports the real n.")

grpMod   = "Statistical Model"
transform = input.string("Log + ATR", "Excursion measure", options=["Percent","Log","Log + ATR"], group=grpMod, tooltip="Percent: (high-open)/open. Simple, but mixes volatility regimes.\n\nLog: ln(high/open). Makes up and down moves symmetric.\n\nLog + ATR (recommended): stores each session as log-excursion divided by the average session range prevailing at that time, then re-scales by the current average. Keeps a quiet week and an event week comparable instead of averaging them into a middle that describes neither.")
atrLen    = input.int(14, "Volatility lookback (sessions)", minval=2, maxval=200, group=grpMod, tooltip="How many prior sessions form the volatility yardstick used by the 'Log + ATR' measure. Always measured from sessions that CLOSED before the one being measured.")
uncondMode = input.bool(false, "Unconditional excursion mode", group=grpMod, tooltip="OFF (default, conditional): the original M/D model. Manipulation is sampled from sessions that closed AGAINST that side, distribution from sessions that closed WITH it.\n\nON (unconditional): every session contributes its up excursion and its down excursion regardless of how it closed. This removes the mismatch that the conditional model is defined by the close — something you do not know at the open. In this mode M and D differ only by their percentile setting.")
pctM      = input.float(50, "Manipulation percentile", minval=1, maxval=99, step=5, group=grpMod, tooltip="Percentile of the manipulation distribution to draw. 50 = median. Read it as: this level is exceeded by (100 - p)% of sessions.")
pctD      = input.float(80, "Distribution percentile", minval=1, maxval=99, step=5, group=grpMod, tooltip="Percentile of the distribution sample. 80 means only 20% of sessions extend beyond this level — a target with a stated probability rather than an average.")
recOn     = input.bool(false, "Recency weighting (exponential)", group=grpMod, tooltip="Weight recent sessions more heavily. Trims the effective sample to about six half-lives, since older sessions carry under 2% weight.")
halfLife  = input.int(60, "Half-life (sessions)", minval=5, maxval=1000, group=grpMod, tooltip="A session this far back counts half as much as the most recent one.")
condMode  = input.string("None", "Condition sample on", options=["None","Weekday","Prior range tercile"], group=grpMod, tooltip="Restrict the sample to sessions sharing the current one's context.\n\nWeekday: a Monday London is not a Friday London, and on session data the difference is large.\nPrior range tercile: range expansion clusters — a compressed session tends to be followed by an expanded one.\n\nConditioning splits an already-modest sample, so watch the n column.")
minSample = input.int(20, "Minimum sample per level", minval=5, maxval=500, group=grpMod, tooltip="Below this the table dims and reach/hold measurement stays in burn-in. Weekday conditioning divides the sample by five, so it needs roughly five times the history to clear this.")

grpM   = "Manipulation (wick / liquidity)"
showM  = input.bool(true,  "Show Manipulation levels", group=grpM)
colM   = input.color(color.new(color.gray, 20), "Color", group=grpM)

grpD   = "Distribution (targets)"
showD  = input.bool(true,  "Show Distribution levels", group=grpD)
colD   = input.color(color.new(color.gray, 20), "Color", group=grpD)

grpO      = "Levels & Style"
drawMode  = input.string("Lines", "Draw levels as", options=["Lines","Zones"], group=grpO, tooltip="Zones widen the median level into a band of +/- a multiple of the sample's standard deviation, which is a more honest picture of where the estimate actually lives. The band uses the same standard deviation reported as ±SE in the table, so nothing new is calculated.")
bandMult  = input.float(0.5, "Zone width (std deviations)", minval=0.05, maxval=3.0, step=0.05, group=grpO)
medStyleIn = input.string("Dashed", "Median line style", options=["Dotted","Dashed","Solid"], group=grpO, tooltip="Mean always draws solid and the percentile always draws dotted, so the three statistics stay distinguishable. This picks the style of the median line between them.")
lnWidth   = input.int(1, "Line width", minval=1, maxval=4, group=grpO)
showMean  = input.bool(true, "Draw mean lines", group=grpO)
showMed   = input.bool(true, "Draw median lines", group=grpO)
showPct   = input.bool(true, "Draw percentile lines", group=grpO)
showFill  = input.bool(true, "Shade mean-median zones", group=grpO)
showO     = input.bool(true, "Show open (accumulation) line", group=grpO, inline="op")
colO      = input.color(color.new(color.orange, 30), "", group=grpO, inline="op")
lblMode   = input.string("Long", "Labels", options=["Long","Short","None"], group=grpO, tooltip="Long: 'NY / + Distribution'. Short: 'NY + D'. The statistic each line carries is appended as mu, ~ or pNN, followed by the price.")
lblSize   = input.string("tiny", "Label size", options=["tiny","small","normal"], group=grpO)
histDim   = input.bool(true, "Dim completed sessions", group=grpO, tooltip="Fades the maps of sessions that have already closed so the running one reads first, while the record of what was projected stays on the chart.")
shadeSess = input.bool(true, "Shade the live session", group=grpO, inline="sh", tooltip="Background tint over the bars belonging to the running session, so the anchor window is obvious at a glance.")
colSess   = input.color(color.new(color.blue, 92), "", group=grpO, inline="sh")

grpW     = "Projection Width"
extendTo = input.string("Session end", "Extend levels to", options=["Session end","Last bar","Fixed bars"], group=grpW, tooltip="Session end projects to the typical close of this session, learned from completed ones, and follows price if the session runs long.")
extBars  = input.int(40, "Fixed bars", minval=1, maxval=500, group=grpW)

grpTm     = "Timing"
showTime  = input.bool(true, "Project average phase times", group=grpTm, tooltip="Vertical markers at the average point inside the session where each phase has historically completed. The manipulation marker spans the two manipulation levels; the high and low markers span the two distribution levels. Measured on chart bars, so on session data this is a first-class statistic rather than a side sample.")
colTime   = input.color(color.new(color.gray, 35), "Marker colour", group=grpTm)
showTimeL = input.bool(true, "Show time labels", group=grpTm)

grpT     = "Table"
showTbl  = input.bool(true, "Show statistics table", group=grpT)
showSeq  = input.bool(true, "Show sequencing & timing rows", group=grpT, tooltip="Does the manipulation side actually get swept BEFORE the distribution target, and when in the session do the extremes print?")
showRange = input.bool(false, "Add average-range row", group=grpT, tooltip="Typical session range implied by the median levels, averaged over the up-close case (lower manipulation to upper distribution) and the down-close case (upper manipulation to lower distribution).")
tblPos   = input.string("bottom_center", "Position", options=["bottom_center","bottom_left","bottom_right","top_center","top_left","top_right","middle_left","middle_right"], group=grpT)
tblSize  = input.string("tiny", "Text size", options=["auto","tiny","small","normal"], group=grpT)
tblTxtCol = input.color(color.new(color.black, 0), "Text colour", group=grpT)
tblBgCol  = input.color(color.new(color.white, 20), "Background", group=grpT)

grpA     = "Alerts"
alertOn  = input.bool(true, "Enable alert() calls", group=grpA, tooltip="Fires on the first tag of each level in a session, and on the close-back-through that actually confirms a manipulation.")

// ============================ Session resolution ==============================
// Everything downstream keys off these three. They are simple-qualified because
// the selectors are inputs, which is what time() requires.
sessSpec = (sessSel == "Asian" ? sessA : sessSel == "London" ? sessL : sessN) + ":" + sessDays
sessTz   = sessSel == "Asian" ? tzA : sessSel == "London" ? tzL : tzN
sessTag  = sessSel == "Asian" ? "ASIA" : sessSel == "London" ? "LDN" : "NY"

inSess  = not na(time(timeframe.period, sessSpec, sessTz))
newSess = inSess and not inSess[1]
endSess = not inSess and inSess[1]

// ============================ Presentation helpers ============================
medStyle  = medStyleIn == "Solid" ? line.style_solid : medStyleIn == "Dotted" ? line.style_dotted : line.style_dashed
labelSize = lblSize == "small" ? size.small : lblSize == "normal" ? size.normal : size.tiny

chartSec = timeframe.in_seconds(timeframe.period)
barMs    = chartSec * 1000

// number of context buckets implied by the conditioning mode
nBuckets = condMode == "Weekday" ? 7 : condMode == "None" ? 1 : 3

// Level ordering, top of the map to the bottom. Also the table's row order.
// 0 = +D, 1 = +M, 2 = Open, 3 = -M, 4 = -D. The sign names which side of the
// open the level sits on.
f_levelName(int i, bool shortForm) =>
    switch i
        0 => shortForm ? "+ D" : "+ Distribution"
        1 => shortForm ? "+ M" : "+ Manipulation"
        2 => shortForm ? "0"   : "Open"
        3 => shortForm ? "- M" : "- Manipulation"
        => shortForm ? "- D" : "- Distribution"

f_levelTag(int i) =>
    switch i
        0 => "+DIS"
        1 => "+MAN"
        2 => "OPEN"
        3 => "-MAN"
        => "-DIS"

// Label text: session, level, which statistic this line is, and its price.
f_lblTxt(int i, string stat, float px) =>
    string s = stat == "" ? "" : "  " + stat
    string p = na(px) ? "" : "  " + str.tostring(px, format.mintick)
    lblMode == "Short" ? sessTag + " " + f_levelName(i, true) + s + p : sessTag + "\n" + f_levelName(i, false) + s + p

// Sessions are intraday, so a clock is always the right stamp here.
f_stamp(int ts) => str.format_time(ts, "HH:mm", sessTz)

// ============================ Shared math helpers =============================
// Rebuild a price level from a stored ratio. Mirrors the excursion measure so
// that whatever transform went in comes back out as a price.
f_lvl(string tfm, float v, float o, float atrp, bool up) =>
    float r = na
    if not na(v) and not na(o)
        if tfm == "Percent"
            r := up ? o * (1.0 + v) : o * (1.0 - v)
        else if tfm == "Log"
            r := up ? o * math.exp(v) : o * math.exp(-v)
        else if not na(atrp)
            r := up ? o * math.exp(v * atrp) : o * math.exp(-v * atrp)
    r

// Exponentially weighted mean. Falls back to a plain average when weighting is
// off, which is the common path and stays on the native implementation.
f_wmean(array<float> vals, float hl) =>
    int n = array.size(vals)
    float res = na
    if n > 0
        if na(hl) or hl <= 0
            res := array.avg(vals)
        else
            float decay = math.pow(0.5, 1.0 / hl)
            float sw = 0.0
            float sv = 0.0
            for i = 0 to n - 1
                float w = math.pow(decay, n - 1 - i)
                sw += w
                sv += array.get(vals, i) * w
            res := sw > 0 ? sv / sw : na
    res

// Weighted percentile. Sorting is native; only the cumulative-weight walk is
// interpreted, and it exits as soon as the threshold is crossed.
f_wpct(array<float> vals, float hl, float pct) =>
    int n = array.size(vals)
    float res = na
    if n > 0
        if na(hl) or hl <= 0
            res := array.percentile_linear_interpolation(vals, pct)
        else
            float decay = math.pow(0.5, 1.0 / hl)
            float tot = decay >= 1.0 ? n : (1.0 - math.pow(decay, n)) / (1.0 - decay)
            array<int> idx = array.sort_indices(vals, order.ascending)
            float target = tot * pct / 100.0
            float cum = 0.0
            for k = 0 to n - 1
                int i = array.get(idx, k)
                cum += math.pow(decay, n - 1 - i)
                if cum >= target
                    res := array.get(vals, i)
                    break
            if na(res)
                res := array.get(vals, array.get(idx, n - 1))
    res

// Mean of the last k entries. The session-native volatility yardstick: an
// average of completed session ranges, never including the session in hand.
f_tailAvg(array<float> a, int k) =>
    int n = array.size(a)
    float res = na
    if n > 0
        int m = math.min(n, k)
        float s = 0.0
        for i = n - m to n - 1
            s += array.get(a, i)
        res := s / m
    res

f_trim(array<float> a, int cap) =>
    while array.size(a) > cap
        array.shift(a)
    true

// ============================== Sample state ==================================
// One entry per COMPLETED session, oldest first. Nothing here is written until
// a session has closed, which is what keeps the projection repaint-free.
var array<float> upA  = array.new<float>()   // up excursion, in the chosen measure
var array<float> dnA  = array.new<float>()   // down excursion
var array<float> blA  = array.new<float>()   // 1 if the session closed up
var array<float> bkA  = array.new<float>()   // context bucket
var array<float> rgA  = array.new<float>()   // range as a fraction of the open
var array<float> hiFA = array.new<float>()   // where in the session the high printed
var array<float> loFA = array.new<float>()   // where the low printed
var array<float> mFA  = array.new<float>()   // where manipulation was first tagged
var array<float> durA = array.new<float>()   // session length in ms

// Rolling walk-forward outcome record for one (level, statistic) combination.
type Outcome
    array<float> reach
    array<float> held

var array<Outcome> ocs = array.new<Outcome>()
if array.size(ocs) == 0
    for j = 0 to 7
        array.push(ocs, Outcome.new(reach = array.new<float>(), held = array.new<float>()))

f_push(Outcome oc, bool reached, bool held, int maxN) =>
    array.push(oc.reach, reached ? 1.0 : 0.0)
    array.push(oc.held, held ? 1.0 : 0.0)
    if array.size(oc.reach) > maxN
        array.shift(oc.reach)
        array.shift(oc.held)
    true

f_reachRate(Outcome oc) =>
    array.size(oc.reach) > 0 ? array.sum(oc.reach) / array.size(oc.reach) : float(na)

f_holdRate(Outcome oc) =>
    float r = array.sum(oc.reach)
    r > 0 ? array.sum(oc.held) / r : float(na)

// -------- the projection frozen at the running session's open ----------------
// Role indices: 0 = +M (upper manipulation), 1 = -M (lower manipulation),
//               2 = +D (upper distribution), 3 = -D (lower distribution).
var array<float> stMean = array.new<float>(4, na)
var array<float> stMed  = array.new<float>(4, na)
var array<float> stPct  = array.new<float>(4, na)
var array<float> stSd   = array.new<float>(4, na)
var array<float> stN    = array.new<float>(4, 0)
var float curAtr  = na
var float curO    = na
var int   startTime = na
var int   bkNow   = 0

// Scratch buffers for the per-session recompute, reused rather than
// reallocated so a long chart does not churn thousands of arrays.
var array<float> f0 = array.new<float>()
var array<float> f1 = array.new<float>()
var array<float> f2 = array.new<float>()
var array<float> f3 = array.new<float>()

// -------- the session under construction -------------------------------------
var float sO   = na
var float sH   = na
var float sL   = na
var int   sBars = 0
var int   hiBar = 0
var int   loBar = 0
var int   firstMBar = -1
var int   firstDBar = -1
var bool  tagM = false
var bool  tagD = false
var float bothN   = 0.0
var float bothHit = 0.0
var float terc1 = na
var float terc2 = na
var float avgDurMs = na

// walk-forward sequencing tallies
var float seqN    = 0.0
var float seqMwin = 0.0
var float seqDwin = 0.0

hl = recOn ? float(halfLife) : float(na)
// Beyond ~6 half-lives a session carries under 2% weight, so trimming there
// costs nothing statistically and keeps the weighted walk bounded.
effMax = recOn ? int(math.min(sampleLen, math.round(halfLife * 6.0))) : sampleLen

// Write one role's statistics into the frozen-projection slots. Taking the
// sample as a parameter avoids selecting between arrays with a ternary.
f_store(int r, array<float> src, float pw) =>
    int m = array.size(src)
    array.set(stN, r, m)
    if m >= 2
        array.set(stMean, r, f_wmean(src, hl))
        array.set(stMed, r, f_wpct(src, hl, 50.0))
        array.set(stPct, r, f_wpct(src, hl, pw))
        array.set(stSd, r, array.stdev(src, false))
    else
        array.set(stMean, r, na)
        array.set(stMed, r, na)
        array.set(stPct, r, na)
        array.set(stSd, r, na)
    true

// ================================ The engine ==================================
// Sessions are rebuilt from chart bars. Booking happens on the first bar AFTER
// the session, where close[1] is the session's final close.

// ---- 1. book the session that just closed -----------------------------------
// A session that resolved to a single bar carries no intra-session information
// and is skipped; the chart-timeframe warning in the table covers that case.
if endSess and not na(sO) and sBars >= 1 and sO > 0 and sH > 0 and sL > 0
    float sC   = close[1]
    bool  bull = sC >= sO
    float rng  = (sH - sL) / sO
    // Volatility known strictly BEFORE this session: the yardstick is built
    // from sessions that had already closed when this one opened, which is the
    // same value the projection was frozen with at this session's own open.
    float atrPrev = f_tailAvg(rgA, atrLen)

    float upV = transform == "Percent" ? (sH - sO) / sO : math.log(sH / sO)
    float dnV = transform == "Percent" ? (sO - sL) / sO : math.log(sO / sL)
    if transform == "Log + ATR"
        if na(atrPrev) or atrPrev <= 0
            upV := float(na)
            dnV := float(na)
        else
            upV := upV / atrPrev
            dnV := dnV / atrPrev

    if not na(upV) and not na(dnV)
        // ---- walk-forward scoring: this session is judged only against the
        // estimate that was frozen at ITS OWN open, out of sessions that had
        // closed before it. No hindsight enters the reach/hold columns. ----
        for r = 0 to 3
            bool upSide = r == 0 or r == 2
            if array.get(stN, r) >= minSample
                float ld = f_lvl(transform, array.get(stMed, r), sO, curAtr, upSide)
                float lp = f_lvl(transform, array.get(stPct, r), sO, curAtr, upSide)
                bool rd = na(ld) ? false : upSide ? sH >= ld : sL <= ld
                bool hd = rd and (upSide ? sC < ld : sC > ld)
                bool rp = na(lp) ? false : upSide ? sH >= lp : sL <= lp
                bool hp = rp and (upSide ? sC < lp : sC > lp)
                f_push(array.get(ocs, r), rd, hd, effMax)
                f_push(array.get(ocs, 4 + r), rp, hp, effMax)

        // ---- whipsaw: how often BOTH manipulation sides get tagged ----
        if array.get(stN, 0) >= minSample and array.get(stN, 1) >= minSample
            float lu = f_lvl(transform, array.get(stMed, 0), sO, curAtr, true)
            float ldn = f_lvl(transform, array.get(stMed, 1), sO, curAtr, false)
            if not na(lu) and not na(ldn)
                bothN += 1.0
                if sH >= lu and sL <= ldn
                    bothHit += 1.0

        // ---- sequencing: did manipulation get tagged before distribution ----
        if firstMBar >= 0 or firstDBar >= 0
            seqN += 1.0
            if firstMBar >= 0 and (firstDBar < 0 or firstMBar < firstDBar)
                seqMwin += 1.0
            else if firstDBar >= 0
                seqDwin += 1.0

        // ---- record the session ----
        float span = math.max(1.0, float(sBars))
        array.push(upA, upV)
        array.push(dnA, dnV)
        array.push(blA, bull ? 1.0 : 0.0)
        array.push(bkA, float(bkNow))
        array.push(hiFA, math.min(1.0, float(hiBar) / span))
        array.push(loFA, math.min(1.0, float(loBar) / span))
        array.push(durA, float(time[1] - startTime + barMs))
        if firstMBar >= 0
            array.push(mFA, math.min(1.0, float(firstMBar) / span))
            f_trim(mFA, effMax)
        if not na(rng)
            array.push(rgA, rng)
            f_trim(rgA, effMax)
        f_trim(upA, effMax)
        f_trim(dnA, effMax)
        f_trim(blA, effMax)
        f_trim(bkA, effMax)
        f_trim(hiFA, effMax)
        f_trim(loFA, effMax)
        f_trim(durA, effMax)

// ---- 2. open the new session and freeze its projection ----------------------
if newSess
    sO := open
    sH := high
    sL := low
    startTime := time
    // sBars counts bars ELAPSED since the open, so the session's first bar is
    // 0 and every phase fraction below lands in [0, 1].
    sBars := 0
    hiBar := 0
    loBar := 0
    firstMBar := -1
    firstDBar := -1
    tagM := false
    tagD := false

    // context bucket for THIS session, from information available at its open
    int nA = array.size(rgA)
    if condMode == "Prior range tercile" and nA >= 15
        terc1 := array.percentile_linear_interpolation(rgA, 33.3333)
        terc2 := array.percentile_linear_interpolation(rgA, 66.6667)
    if condMode == "Weekday"
        bkNow := dayofweek(startTime, sessTz) - 1
    else if condMode == "Prior range tercile"
        float pr = nA > 0 ? array.get(rgA, nA - 1) : na
        bkNow := na(pr) or na(terc1) ? 1 : pr <= terc1 ? 0 : pr <= terc2 ? 1 : 2
    else
        bkNow := 0
    bkNow := math.max(0, math.min(nBuckets - 1, bkNow))

    curAtr := f_tailAvg(rgA, atrLen)
    avgDurMs := f_tailAvg(durA, 20)

    // ---- recompute the four role samples for this session's bucket ----
    array.clear(f0)
    array.clear(f1)
    array.clear(f2)
    array.clear(f3)
    int n = array.size(upA)
    if n > 0
        for i = 0 to n - 1
            if nBuckets == 1 or int(array.get(bkA, i)) == bkNow
                float u = array.get(upA, i)
                float d = array.get(dnA, i)
                if uncondMode
                    array.push(f0, u)
                    array.push(f1, d)
                    array.push(f2, u)
                    array.push(f3, d)
                else if array.get(blA, i) > 0.5
                    array.push(f1, d)
                    array.push(f2, u)
                else
                    array.push(f0, u)
                    array.push(f3, d)

    f_store(0, f0, pctM)
    f_store(1, f1, pctM)
    f_store(2, f2, pctD)
    f_store(3, f3, pctD)
    curO := sO

// ---- 3. extend the running session ------------------------------------------
else if inSess and not na(sO)
    sBars += 1
    if high > sH
        sH := high
        hiBar := sBars
    if low < sL
        sL := low
        loBar := sBars

// ============================ Level reconstruction ============================
appliedAtr = transform == "Log + ATR" ? curAtr : float(na)

f_lvlAt(int role, array<float> src) =>
    f_lvl(transform, array.get(src, role), curO, appliedAtr, role == 0 or role == 2)

lvlPMm = f_lvlAt(0, stMean)
lvlPMd = f_lvlAt(0, stMed)
lvlPMp = f_lvlAt(0, stPct)
lvlNMm = f_lvlAt(1, stMean)
lvlNMd = f_lvlAt(1, stMed)
lvlNMp = f_lvlAt(1, stPct)
lvlPDm = f_lvlAt(2, stMean)
lvlPDd = f_lvlAt(2, stMed)
lvlPDp = f_lvlAt(2, stPct)
lvlNDm = f_lvlAt(3, stMean)
lvlNDd = f_lvlAt(3, stMed)
lvlNDp = f_lvlAt(3, stPct)

n0 = array.get(stN, 0)
n1 = array.get(stN, 1)
n2 = array.get(stN, 2)
n3 = array.get(stN, 3)
smallestN = math.min(math.min(n0, n1), math.min(n2, n3))
hasStats  = smallestN >= 5
thin      = smallestN < minSample
// A chart bar at or above the session length cannot resolve the session at all.
tfInverted = chartSec >= (na(avgDurMs) ? 3600.0 : avgDurMs / 1000.0)

// Standard error of the mean: sd / sqrt(n). The honest width of the estimate.
f_se(int role) =>
    float sd = array.get(stSd, role)
    float nn = array.get(stN, role)
    na(sd) or nn < 2 ? float(na) : sd / math.sqrt(nn)

// ============================= Drawing helpers ================================
// x is a TIMESTAMP throughout: a session on a 1m chart runs past the 500-bar
// future limit that xloc.bar_index imposes, and xloc.bar_time has no such cap.
type LevelGroup
    array<line>     lines
    array<color>    lineCols
    array<linefill> fills
    array<label>    labels
    array<color>    labelCols
    array<box>      boxes
    array<color>    boxCols

var array<LevelGroup> groups = array.new<LevelGroup>()
var LevelGroup active = na
var bool liveGroup = false

f_newGroup() =>
    LevelGroup.new(array.new<line>(), array.new<color>(), array.new<linefill>(),
         array.new<label>(), array.new<color>(), array.new<box>(), array.new<color>())

projMs = extendTo == "Fixed bars" ? extBars * barMs : int(na(avgDurMs) ? 0.0 : avgDurMs)

mkLine(int x, float y, color c, string st, int w) =>
    na(y) ? na : line.new(x, y, x + projMs, y, xloc=xloc.bar_time, color=c, style=st, width=w)

mkLabel(int x, float y, string txt, color c) =>
    na(y) ? na : label.new(x, y, txt, xloc=xloc.bar_time, style=label.style_label_left,
         color=color.new(color.black, 100), textcolor=c, size=labelSize, textalign=text.align_left)

f_add(LevelGroup g, line ln, color c) =>
    if not na(ln)
        array.push(g.lines, ln)
        array.push(g.lineCols, c)

f_addLbl(LevelGroup g, label lb, color c) =>
    if not na(lb)
        array.push(g.labels, lb)
        array.push(g.labelCols, c)

// Fade every drawing a group owns, once its session has closed.
f_dim(LevelGroup g) =>
    if not na(g)
        if array.size(g.lines) > 0
            for i = 0 to array.size(g.lines) - 1
                line.set_color(array.get(g.lines, i), color.new(array.get(g.lineCols, i), 70))
        if array.size(g.labels) > 0
            for i = 0 to array.size(g.labels) - 1
                label.set_textcolor(array.get(g.labels, i), color.new(array.get(g.labelCols, i), 70))
        if array.size(g.boxes) > 0
            for i = 0 to array.size(g.boxes) - 1
                box.set_bgcolor(array.get(g.boxes, i), color.new(array.get(g.boxCols, i), 80))
    true

// Band edges for a Zones-mode level, from the same standard deviation the table
// reports as ±SE. Widened in ratio space, then converted to price.
f_bandHi(int role, bool up) =>
    float r = array.get(stMed, role)
    float sd = array.get(stSd, role)
    na(r) or na(sd) or sd <= 0 ? float(na) : f_lvl(transform, r + bandMult * sd, curO, appliedAtr, up)

f_bandLo(int role, bool up) =>
    float r = array.get(stMed, role)
    float sd = array.get(stSd, role)
    na(r) or na(sd) or sd <= 0 ? float(na) : f_lvl(transform, math.max(0.0, r - bandMult * sd), curO, appliedAtr, up)

// Draw one side of one level family: mean, median and percentile.
f_drawSet(LevelGroup g, int x, float vm, float vd, float vp, float bHi, float bLo, color col, int li) =>
    line lm = showMean ? mkLine(x, vm, col, line.style_solid, lnWidth) : na
    line ld = showMed ? mkLine(x, vd, col, medStyle, lnWidth) : na
    line lp = showPct ? mkLine(x, vp, col, line.style_dotted, lnWidth) : na
    f_add(g, lm, col)
    f_add(g, ld, col)
    f_add(g, lp, col)
    if drawMode == "Zones" and not na(bHi) and not na(bLo)
        array.push(g.boxes, box.new(x, math.max(bHi, bLo), x + projMs, math.min(bHi, bLo),
             xloc=xloc.bar_time, border_color=color.new(col, 100), bgcolor=color.new(col, 55)))
        array.push(g.boxCols, color.new(col, 55))
    else if showFill and not na(lm) and not na(ld)
        array.push(g.fills, linefill.new(lm, ld, color.new(col, 86)))
    if lblMode != "None"
        float pShown = (li == 1 or li == 3) ? pctM : pctD
        f_addLbl(g, showMean ? mkLabel(x, vm, f_lblTxt(li, "mu", vm), col) : na, col)
        f_addLbl(g, showMed ? mkLabel(x, vd, f_lblTxt(li, "~", vd), col) : na, col)
        f_addLbl(g, showPct ? mkLabel(x, vp, f_lblTxt(li, "p" + str.tostring(pShown, "#"), vp), col) : na, col)

// Vertical marker at the average point inside the session where a phase has
// historically completed, spanning the pair of levels it belongs to.
f_timeMark(LevelGroup g, int x0, float frac, float yA, float yB, string tag) =>
    if showTime and not na(frac) and not na(yA) and not na(yB) and not na(avgDurMs)
        int xm = x0 + int(math.round(frac * avgDurMs))
        array.push(g.lines, line.new(xm, yA, xm, yB, xloc=xloc.bar_time, color=colTime, style=line.style_dotted, width=lnWidth))
        array.push(g.lineCols, colTime)
        if showTimeL
            label lb = label.new(xm, math.min(yA, yB), tag + " " + f_stamp(xm), xloc=xloc.bar_time,
                 style=label.style_label_up, color=color.new(color.black, 100),
                 textcolor=colTime, size=labelSize)
            array.push(g.labels, lb)
            array.push(g.labelCols, colTime)
    true

// ==================== Build a fresh group at each session open ================
if newSess and hasStats
    g = f_newGroup()
    if showO
        f_add(g, mkLine(startTime, curO, colO, line.style_solid, lnWidth), colO)
        if lblMode != "None"
            f_addLbl(g, mkLabel(startTime, curO, f_lblTxt(2, "", curO), colO), colO)
    // Drawn top of the map to the bottom: +D, +M, open, -M, -D.
    if showD
        f_drawSet(g, startTime, lvlPDm, lvlPDd, lvlPDp, f_bandHi(2, true), f_bandLo(2, true), colD, 0)
    if showM
        f_drawSet(g, startTime, lvlPMm, lvlPMd, lvlPMp, f_bandHi(0, true), f_bandLo(0, true), colM, 1)
        f_drawSet(g, startTime, lvlNMm, lvlNMd, lvlNMp, f_bandHi(1, false), f_bandLo(1, false), colM, 3)
    if showD
        f_drawSet(g, startTime, lvlNDm, lvlNDd, lvlNDp, f_bandHi(3, false), f_bandLo(3, false), colD, 4)
    // Phase timing, from the walk-forward accumulators the table also reports.
    f_timeMark(g, startTime, array.size(mFA) > 0 ? array.avg(mFA) : float(na), lvlPMd, lvlNMd, "M")
    f_timeMark(g, startTime, array.size(hiFA) > 0 ? array.avg(hiFA) : float(na), lvlPDd, lvlNDd, "H")
    f_timeMark(g, startTime, array.size(loFA) > 0 ? array.avg(loFA) : float(na), lvlPDd, lvlNDd, "L")

    if histDim
        f_dim(active)
    array.push(groups, g)
    active := g
    liveGroup := true
    if array.size(groups) > periodsShow
        old = array.shift(groups)
        for fl in old.fills
            linefill.delete(fl)
        for ln in old.lines
            line.delete(ln)
        for lb in old.labels
            label.delete(lb)
        for bx in old.boxes
            box.delete(bx)

// The map stops growing when the session closes; it is then a finished record.
if endSess
    liveGroup := false

if liveGroup and not na(active)
    // "Session end" runs to the typical close of this session, learned from
    // completed ones, and follows price if the session runs long.
    int sessEndT = startTime + int(na(avgDurMs) ? 0.0 : avgDurMs)
    rightX = extendTo == "Last bar" ? time :
         extendTo == "Fixed bars" ? time + extBars * barMs :
         sessEndT > time ? sessEndT : time
    for ln in active.lines
        // level lines are horizontal; the vertical timing markers keep their x
        if line.get_y1(ln) == line.get_y2(ln)
            line.set_x2(ln, rightX)
    if array.size(active.labels) > 0
        for i = 0 to array.size(active.labels) - 1
            if array.get(active.labelCols, i) != colTime
                label.set_x(array.get(active.labels, i), rightX)
    for bx in active.boxes
        box.set_right(bx, rightX)

bgcolor(shadeSess and inSess ? colSess : na, title="Session shading")

// ======================== Level touches, alerts, sequence =====================
hitPM = not na(lvlPMd) and inSess and high >= lvlPMd
hitNM = not na(lvlNMd) and inSess and low <= lvlNMd
hitPD = not na(lvlPDd) and inSess and high >= lvlPDd
hitND = not na(lvlNDd) and inSess and low <= lvlNDd

newTagM = (hitPM or hitNM) and not tagM
newTagD = (hitPD or hitND) and not tagD
if newTagM
    tagM := true
    firstMBar := sBars
if newTagD
    tagD := true
    firstDBar := sBars

// A manipulation is only "confirmed" once price closes back through the level
// it swept — the reversal, not the touch, is the signal.
confM = tagM and ((hitPM and close < lvlPMd) or (hitNM and close > lvlNMd))

alertcondition(newTagM, "Manipulation level tagged", "Price reached a manipulation level")
alertcondition(newTagD, "Distribution level tagged", "Price reached a distribution target")
alertcondition(confM,   "Manipulation confirmed",    "Price swept a manipulation level and closed back through")

if alertOn
    if newTagM
        alert("Manipulation level tagged on " + syminfo.ticker + " (" + sessSel + " session)", alert.freq_once_per_bar)
    if newTagD
        alert("Distribution target tagged on " + syminfo.ticker + " (" + sessSel + " session)", alert.freq_once_per_bar)
    if confM
        alert("Manipulation CONFIRMED on " + syminfo.ticker + " — swept and closed back through", alert.freq_once_per_bar)

// ================================ Stats table =================================
// Laid out top of the map to the bottom (+DIS, +MAN, OPEN, -MAN, -DIS) so the
// rows read in the same order the levels sit on the chart.
f_tablePos(string p) =>
    switch p
        "bottom_left"  => position.bottom_left
        "bottom_right" => position.bottom_right
        "top_center"   => position.top_center
        "top_left"     => position.top_left
        "top_right"    => position.top_right
        "middle_left"  => position.middle_left
        "middle_right" => position.middle_right
        => position.bottom_center

posSel  = f_tablePos(tblPos)
sizeSel = tblSize == "auto" ? size.auto : tblSize == "small" ? size.small : tblSize == "normal" ? size.normal : size.tiny

// Units follow the measure: ATR mode is dimensionless, the rest are percentages.
f_ratio(float v) =>
    na(v) ? "—" : transform == "Log + ATR" ? str.tostring(v, "#.##") + "x" : str.tostring(v * 100, "#.##") + "%"

f_ratioSe(float v, float se) =>
    na(v) ? "—" : f_ratio(v) + (na(se) ? "" : " ±" + (transform == "Log + ATR" ? str.tostring(se, "#.##") : str.tostring(se * 100, "#.##")))

f_rate(float r) => na(r) ? "—" : str.tostring(math.round(r * 100)) + "%"

f_price(float p) => na(p) ? "—" : str.tostring(p, format.mintick)

var table t = table.new(posSel, 8, 12, border_width=1,
     border_color=color.new(color.gray, 60), frame_width=1, frame_color=color.new(color.gray, 60))

txtC  = thin ? color.new(tblTxtCol, 55) : tblTxtCol
dimC  = color.new(tblTxtCol, 45)
warnC = color.new(color.orange, 0)

// One level row: tag, projected price, then the statistics behind it.
f_lvlRow(int r, int li, int role, float px, color tagCol) =>
    table.cell(t, 0, r, f_levelTag(li), text_color=thin ? color.new(tagCol, 55) : tagCol,
         text_size=sizeSel, text_halign=text.align_left, bgcolor=tblBgCol)
    table.cell(t, 1, r, f_price(px), text_color=txtC, text_size=sizeSel, bgcolor=tblBgCol)
    table.cell(t, 2, r, f_ratioSe(array.get(stMean, role), f_se(role)), text_color=txtC, text_size=sizeSel, bgcolor=tblBgCol)
    table.cell(t, 3, r, f_ratio(array.get(stMed, role)), text_color=txtC, text_size=sizeSel, bgcolor=tblBgCol)
    table.cell(t, 4, r, f_ratio(array.get(stPct, role)), text_color=txtC, text_size=sizeSel, bgcolor=tblBgCol)
    table.cell(t, 5, r, f_rate(f_reachRate(array.get(ocs, role))), text_color=txtC, text_size=sizeSel, bgcolor=tblBgCol,
         tooltip="percentile level reach: " + f_rate(f_reachRate(array.get(ocs, 4 + role))))
    table.cell(t, 6, r, f_rate(f_holdRate(array.get(ocs, role))), text_color=txtC, text_size=sizeSel, bgcolor=tblBgCol,
         tooltip="percentile level hold: " + f_rate(f_holdRate(array.get(ocs, 4 + role))))
    table.cell(t, 7, r, str.tostring(array.get(stN, role), "#"), text_color=txtC, text_size=sizeSel, bgcolor=tblBgCol)

if barstate.islast and showTbl
    table.cell(t, 0, 0, sessTag, text_color=tblTxtCol, text_size=sizeSel, text_halign=text.align_left, bgcolor=tblBgCol, tooltip=sessSel + " " + sessSpec + " " + sessTz + "\nMeasure: " + transform + (uncondMode ? " · unconditional" : " · conditional") + (recOn ? " · half-life " + str.tostring(halfLife) : "") + (condMode != "None" ? " · conditioned on " + condMode : ""))
    table.cell(t, 1, 0, "Price",    text_color=tblTxtCol, text_size=sizeSel, bgcolor=tblBgCol, tooltip="The median level, which is the line the reach and hold columns are measured against.")
    table.cell(t, 2, 0, "Mean ±SE", text_color=tblTxtCol, text_size=sizeSel, bgcolor=tblBgCol)
    table.cell(t, 3, 0, "Median",   text_color=tblTxtCol, text_size=sizeSel, bgcolor=tblBgCol)
    table.cell(t, 4, 0, "Pctile",   text_color=tblTxtCol, text_size=sizeSel, bgcolor=tblBgCol)
    table.cell(t, 5, 0, "Reach",    text_color=tblTxtCol, text_size=sizeSel, bgcolor=tblBgCol, tooltip="How often price TOUCHED the median level. This is the number you want for setting targets.")
    table.cell(t, 6, 0, "Hold",     text_color=tblTxtCol, text_size=sizeSel, bgcolor=tblBgCol, tooltip="Of the times it was reached, how often price closed back through it — the reversal rate.")
    table.cell(t, 7, 0, "n",        text_color=tblTxtCol, text_size=sizeSel, bgcolor=tblBgCol)

    // Levels, top of the map to the bottom.
    f_lvlRow(1, 0, 2, lvlPDd, colD)
    f_lvlRow(2, 1, 0, lvlPMd, colM)

    // Open
    table.cell(t, 0, 3, f_levelTag(2), text_color=colO, text_size=sizeSel, text_halign=text.align_left, bgcolor=tblBgCol)
    table.cell(t, 1, 3, f_price(curO), text_color=txtC, text_size=sizeSel, bgcolor=tblBgCol)
    for c = 2 to 7
        table.cell(t, c, 3, "", bgcolor=tblBgCol)

    f_lvlRow(4, 3, 1, lvlNMd, colM)
    f_lvlRow(5, 4, 3, lvlNDd, colD)

    // Typical session range implied by the median levels.
    if showRange
        float rngUp = na(lvlPDd) or na(lvlNMd) ? float(na) : lvlPDd - lvlNMd
        float rngDn = na(lvlPMd) or na(lvlNDd) ? float(na) : lvlPMd - lvlNDd
        float rng   = na(rngUp) or na(rngDn) ? float(na) : (rngUp + rngDn) / 2.0
        table.cell(t, 0, 6, "RNG", text_color=dimC, text_size=sizeSel, text_halign=text.align_left, bgcolor=tblBgCol, tooltip="Average of the up-close range (-MAN to +DIS) and the down-close range (+MAN to -DIS), both from the median levels.")
        table.cell(t, 1, 6, f_price(rng), text_color=txtC, text_size=sizeSel, bgcolor=tblBgCol)
        for c = 2 to 7
            table.cell(t, c, 6, "", bgcolor=tblBgCol)

    // Whipsaw / volatility
    table.cell(t, 0, 7, "both-side", text_color=dimC, text_size=sizeSel, text_halign=text.align_left, bgcolor=tblBgCol, tooltip="How often BOTH manipulation levels were tagged in the same session — the whipsaw rate, i.e. how often this model's premise fails.")
    table.cell(t, 1, 7, f_rate(bothN > 0 ? bothHit / bothN : float(na)), text_color=txtC, text_size=sizeSel, bgcolor=tblBgCol)
    table.cell(t, 2, 7, "vol", text_color=dimC, text_size=sizeSel, bgcolor=tblBgCol)
    table.cell(t, 3, 7, na(curAtr) ? "—" : str.tostring(curAtr * 100, "#.##") + "%", text_color=txtC, text_size=sizeSel, bgcolor=tblBgCol, tooltip="Average session range as a percentage of the open, over the volatility lookback. In 'Log + ATR' mode this is the scale every stored ratio is multiplied by.")
    table.cell(t, 4, 7, "scored", text_color=dimC, text_size=sizeSel, bgcolor=tblBgCol)
    table.cell(t, 5, 7, str.tostring(array.size(array.get(ocs, 0).reach), "#"), text_color=txtC, text_size=sizeSel, bgcolor=tblBgCol, tooltip="Sessions scored walk-forward for the reach/hold columns.")
    for c = 6 to 7
        table.cell(t, c, 7, "", bgcolor=tblBgCol)

    // Session / sample health
    table.cell(t, 0, 8, "Session", text_color=dimC, text_size=sizeSel, text_halign=text.align_left, bgcolor=tblBgCol)
    table.cell(t, 1, 8, sessSel, text_color=dimC, text_size=sizeSel, bgcolor=tblBgCol, tooltip=sessSpec + "  " + sessTz)
    table.cell(t, 2, 8, str.tostring(array.size(upA)) + " held", text_color=dimC, text_size=sizeSel, bgcolor=tblBgCol, tooltip="Completed sessions currently in the sample. Bounded by how much CHART history is loaded, so it grows as you scroll back.")
    table.cell(t, 3, 8, tfInverted ? "CHART TF TOO HIGH" : thin ? "THIN SAMPLE" : "", text_color=(tfInverted or thin) ? warnC : dimC, text_size=sizeSel, bgcolor=tblBgCol, tooltip=tfInverted ? "Your chart timeframe is at or above the session length, so the session cannot be resolved into bars. Drop to 1m-15m." : thin ? "At least one level has fewer than " + str.tostring(minSample) + " samples. Treat these levels as indicative only." : "")
    for c = 4 to 7
        table.cell(t, c, 8, "", bgcolor=tblBgCol)

    if showSeq
        table.cell(t, 0, 9, "Sequence", text_color=tblTxtCol, text_size=sizeSel, text_halign=text.align_left, bgcolor=tblBgCol, tooltip="Measured on chart bars over " + str.tostring(seqN, "#") + " sessions — on session data this is a first-class sample, not a side one.")
        table.cell(t, 1, 9, "M first", text_color=colM, text_size=sizeSel, bgcolor=tblBgCol)
        table.cell(t, 2, 9, seqN > 0 ? f_rate(seqMwin / seqN) : "—", text_color=txtC, text_size=sizeSel, bgcolor=tblBgCol)
        table.cell(t, 3, 9, "D first", text_color=colD, text_size=sizeSel, bgcolor=tblBgCol)
        table.cell(t, 4, 9, seqN > 0 ? f_rate(seqDwin / seqN) : "—", text_color=txtC, text_size=sizeSel, bgcolor=tblBgCol)
        table.cell(t, 5, 9, "n=" + str.tostring(seqN, "#"), text_color=dimC, text_size=sizeSel, bgcolor=tblBgCol)
        for c = 6 to 7
            table.cell(t, c, 9, "", bgcolor=tblBgCol)

        table.cell(t, 0, 10, "Timing", text_color=tblTxtCol, text_size=sizeSel, text_halign=text.align_left, bgcolor=tblBgCol, tooltip="Average position within the session, as a fraction of its length, at which each event printed. These are the fractions the chart's vertical phase markers are drawn from.")
        table.cell(t, 1, 10, "high at", text_color=dimC, text_size=sizeSel, bgcolor=tblBgCol)
        table.cell(t, 2, 10, array.size(hiFA) > 0 ? str.tostring(array.avg(hiFA) * 100, "#") + "%" : "—", text_color=txtC, text_size=sizeSel, bgcolor=tblBgCol)
        table.cell(t, 3, 10, "low at", text_color=dimC, text_size=sizeSel, bgcolor=tblBgCol)
        table.cell(t, 4, 10, array.size(loFA) > 0 ? str.tostring(array.avg(loFA) * 100, "#") + "%" : "—", text_color=txtC, text_size=sizeSel, bgcolor=tblBgCol)
        table.cell(t, 5, 10, "M tag at", text_color=dimC, text_size=sizeSel, bgcolor=tblBgCol)
        table.cell(t, 6, 10, array.size(mFA) > 0 ? str.tostring(array.avg(mFA) * 100, "#") + "%" : "—", text_color=txtC, text_size=sizeSel, bgcolor=tblBgCol)
        table.cell(t, 7, 10, "", bgcolor=tblBgCol)
